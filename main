import math, sys, datetime
import numpy as np
import functools
from dataclasses import dataclass
from typing import List, Optional

# =================================================================== #
# 1. Math Library (Racah Algebra)                                     #
# =================================================================== #
_fact_cache = {0:1, 1:1}
def fact(n):
    n_int = int(round(n))
    if n_int < 0: return 0
    if n_int in _fact_cache: return _fact_cache[n_int]
    res = math.factorial(n_int)
    _fact_cache[n_int] = res
    return res

def delta(a, b, c):
    den = fact(a+b+c+1)
    if den == 0: return 0.0
    val = fact(a+b-c) * fact(a-b+c) * fact(-a+b+c) / den
    return math.sqrt(max(0.0, val))

@functools.lru_cache(maxsize=None)
def wigner6j(j1, j2, j3, J1, J2, J3):
    if (j1+j2<j3) or (abs(j1-j2)>j3): return 0.0
    if (j1+J2<J3) or (abs(j1-J2)>J3): return 0.0
    if (J1+j2<J3) or (abs(J1-j2)>J3): return 0.0
    if (J1+J2<j3) or (abs(J1-J2)>j3): return 0.0
    
    tmin = int(round(max(j1+j2+j3, j1+J2+J3, J1+j2+J3, J1+J2+j3)))
    tmax = int(round(min(j1+j2+J1+J2, j2+j3+J2+J3, j3+j1+J3+J1)))
    
    s = 0.0
    for t in range(tmin, tmax + 1):
        den = fact(t-(j1+j2+j3))*fact(t-(j1+J2+J3))*fact(t-(J1+j2+J3))*fact(t-(J1+J2+j3)) * \
              fact(j1+j2+J1+J2-t)*fact(j2+j3+J2+J3-t)*fact(j3+j1+J3+J1-t)
        if den > 0:
            num = fact(t+1) * ((-1)**t)
            s += num / den
    
    return s * delta(j1,j2,j3)*delta(j1,J2,J3)*delta(J1,j2,J3)*delta(J1,J2,j3)

@functools.lru_cache(maxsize=None)
def wigner3j(j1, j2, j3, m1, m2, m3):
    if abs(m1 + m2 + m3) > 1e-9: return 0.0
    if j3 < abs(j1 - j2) or j3 > j1 + j2: return 0.0
    if abs(m1) > j1 or abs(m2) > j2 or abs(m3) > j3: return 0.0
    
    tmin = int(round(max(0, j2 - j3 - m1, j1 - j3 + m2)))
    tmax = int(round(min(j1 + j2 - j3, j1 - m1, j2 + m2)))
    
    s = 0.0
    for k in range(tmin, tmax + 1):
        den = fact(k) * fact(j1 + j2 - j3 - k) * fact(j1 - m1 - k) * \
              fact(j2 + m2 - k) * fact(j3 - j2 + m1 + k) * fact(j3 - j1 - m2 + k)
        if den > 0:
            s += ((-1)**k) / den
            
    prefactor_den = fact(j1 + j2 + j3 + 1)
    if prefactor_den == 0: return 0.0
    
    prefactor_val = fact(j1 + j2 - j3) * fact(j1 - j2 + j3) * fact(-j1 + j2 + j3) / prefactor_den * \
                    fact(j1 + m1) * fact(j1 - m1) * fact(j2 + m2) * fact(j2 - m2) * fact(j3 + m3) * fact(j3 - m3)
    
    prefactor = math.sqrt(max(0.0, prefactor_val))
    
    res = s * prefactor
    if int(round(j1 - j2 - m3)) % 2 != 0:
        res = -res
    return res

@functools.lru_cache(maxsize=None)
def wigner9j(j1, j2, j3, j4, j5, j6, j7, j8, j9) -> float:
    def check_tri(a, b, c): return (abs(a - b) <= c <= a + b)
    if not (check_tri(j1, j2, j3) and check_tri(j4, j5, j6) and check_tri(j7, j8, j9) and
            check_tri(j1, j4, j7) and check_tri(j2, j5, j8) and check_tri(j3, j6, j9)): return 0.0

    k_min = max(abs(j1 - j9), abs(j2 - j6), abs(j4 - j8))
    k_max = min(j1 + j9, j2 + j6, j4 + j8)
    
    total = 0.0
    for k in range(int(k_min), int(k_max) + 1):
        w1, w2, w3 = wigner6j(j1, j4, j7, j8, j9, k), wigner6j(j2, j5, j8, j4, k, j6), wigner6j(j3, j6, j9, k, j1, j2)
        if w1 != 0.0 and w2 != 0.0 and w3 != 0.0: total += ((-1)**(2*k)) * (2*k + 1) * w1 * w2 * w3
    return total

# =================================================================== #
# 2. Global Config                                                    #
# =================================================================== #
class P:
    FORMAT = 'SRR'; MODE = 'SRR'; STATISTICS = 0; SPINS = []; S = 0.5 
    
    A = B = C = DJ = DJK = DK = dJ = dK = d1 = d2 = 0.0
    
    Xaa = Xbb_Xcc = Xab = Xac = Xbc = 0.0
    Xaa2 = Xbb_Xcc2 = Xab2 = Xac2 = Xbc2 = 0.0
    Xaa3 = Xbb_Xcc3 = Xab3 = Xac3 = Xbc3 = 0.0
    Xaa4 = Xbb_Xcc4 = Xab4 = Xac4 = Xbc4 = 0.0
    Xaa5 = Xbb_Xcc5 = Xab5 = Xac5 = Xbc5 = 0.0
    Xaa_p = Xaa_m = Xbb_Xcc_p = Xbb_Xcc_m = Xab_p = Xab_m = Xac_p = Xac_m = Xbc_p = Xbc_m = 0.0
    
    Eaa = Ebb = Ecc = 0.0; Eab = Ebc = Eac = 0.0
    Caa = Cbb = Ccc = Caa2 = Cbb2 = Ccc2 = Caa3 = Cbb3 = Ccc3 = Caa4 = Cbb4 = Ccc4 = Caa5 = Cbb5 = Ccc5 = 0.0
    Caa_p = Caa_m = Cbb_p = Cbb_m = Ccc_p = Ccc_m = 0.0
    
    AF = TAA = TBB_TCC = AF2 = TAA2 = TBB_TCC2 = AF3 = TAA3 = TBB_TCC3 = 0.0
    TAB = TAB2 = TAB3 = 0.0
    Daa = Dbb_Dcc = 0.0
    AF4 = TAA4 = TBB_TCC4 = TAB4 = CAA4 = CBB4 = CCC4 = 0.0
    AF5 = TAA5 = TBB_TCC5 = TAB5 = CAA5 = CBB5 = CCC5 = 0.0
    
    F0 = 160.0; V3 = 1000.0; DELTA = 0.0; EPSILON = 0.0; VT_MAX = 5      
    F = RHO_a = RHO_b = I_ALPHA = 0.0
    
    REDUCTION = 'A'; REP = 'Ir'; TEMP = 300.0; JMIN = 0; JMAX = 10; FMIN = 0.0; FMAX = 20000.0 
    MUA = 1.0; MUB = 0.0; MUC = 0.0; FTH = 0.01; FDIF = 0.0025; OLVL = 0; DUMP = 1.0
    PUBL = 1; DIAG = 1; eQq_I = 2292.712; kb_MHz = 20836.619; LInt = -99.0

class Run:
    NAME = ''; LINES = []; VARY = []; NCY = 10
    INIT_A = INIT_B = INIT_C = 0.0

@dataclass
class Line:
    N1: int; K1: int; Kp1: int; N2: int; K2: int; Kp2: int
    freq: float; weight: float; error: float
    # Expanded F intermediate states
    J1: Optional[float] = None; F1_1: Optional[float] = None; F1_2: Optional[float] = None; F1_3: Optional[float] = None; F1_4: Optional[float] = None; F1: Optional[float] = None
    J2: Optional[float] = None; F2_1: Optional[float] = None; F2_2: Optional[float] = None; F2_3: Optional[float] = None; F2_4: Optional[float] = None; F2: Optional[float] = None
    I1: Optional[float] = None; I2: Optional[float] = None
    Sym: int = 0; calc: float = 0.0; res: float = 0.0

# =================================================================== #
# 3. Unified Input Parser                                             #
# =================================================================== #
def parse_input(path: str) -> None:
    try:
        with open(path, encoding='utf-8', errors='ignore') as f: txt = f.read()
    except FileNotFoundError: print(f"Error: {path} not found."); sys.exit(1)

    lines = txt.splitlines()
    if not lines: return
    Run.NAME = lines[0].strip()
    Run.LINES = []; Run.VARY = []; P.SPINS = []
    
    idx = 0; trans_start = -1
    while idx < len(lines):
        raw = lines[idx].strip()
        if raw.upper().startswith('TRANSITIONS') or raw.upper().startswith('TRANSI'): trans_start = idx; break
        parts = raw.split()
        if len(parts) >= 2:
            key = parts[0].upper()
            
            alias_map = {
                'EAA': 'EAA', 'EBB': 'EBB', 'ECC': 'ECC',
                'EPSAA': 'EAA', 'EPSBB': 'EBB', 'EPSCC': 'ECC',
                'AF(H1)': 'AF', 'TAA(H1)': 'TAA', 'TBB(H1)': 'TBB', 'TCC(H1)': 'TCC',
                'AF(H2)': 'AF2', 'TAA(H2)': 'TAA2', 'TBB(H2)': 'TBB2', 'TCC(H2)': 'TCC2',
                'AF(H3)': 'AF3', 'TAA(H3)': 'TAA3', 'TBB(H3)': 'TBB3', 'TCC(H3)': 'TCC3',
                'AF(H4)': 'AF4', 'TAA(H4)': 'TAA4', 'TBB(H4)': 'TBB4', 'TCC(H4)': 'TCC4',
                'AF(H5)': 'AF5', 'TAA(H5)': 'TAA5', 'TBB(H5)': 'TBB5', 'TCC(H5)': 'TCC5',
                '(EAB+EBA)/2': 'EAB', 'TAB(H1)': 'TAB', 'CAA(H1)': 'CAA',
                'TAB(H2)': 'TAB2', 'CAA(H2)': 'CAA2', 'TAB(H3)': 'TAB3', 'CAA(H3)': 'CAA3',
                'TAB(H4)': 'TAB4', 'CAA(H4)': 'CAA4', 'TAB(H5)': 'TAB5', 'CAA(H5)': 'CAA5'
            }
            if key in alias_map: key = alias_map[key]

            if key in ['FORMAT', 'TEMP','MUA','MUB','MUC','LINT','FMIN','FMAX','JMIN','JMAX','ITER','REDUCTION','REP', 'FTH', 'FDIF', 'OLVL', 'DUMP', 'PUBL', 'DIAG', 'EQQ_I', 'VT_MAX', 'STATISTICS']:
                try:
                    if key in ['JMIN','JMAX','ITER', 'OLVL', 'PUBL', 'DIAG', 'VT_MAX', 'STATISTICS']: val = int(float(parts[1]))
                    elif key in ['REDUCTION','REP', 'FORMAT']: val = parts[1]
                    else: val = float(parts[1])
                    
                    if key == 'ITER': Run.NCY = val
                    elif key == 'REDUCTION': P.REDUCTION = val.upper()
                    elif key == 'REP': P.REP = val
                    elif key == 'EQQ_I': P.eQq_I = val
                    elif key == 'FORMAT': P.FORMAT = P.MODE = val.upper()
                    else: setattr(P, key, val)
                except: pass
            elif key == 'SPIN':
                for x in parts[1:]: P.SPINS.append(float(x))
            elif key in [
                'A','B','C','DJ','DJK','DK','DELTAJ','DELTAK','D1','D2',
                'XAA','XBB-XCC','XBB_XCC','XAB','XAC','XBC', 
                'CAA', 'CBB', 'CCC', 
                'XAA2','XBB-XCC2','XBB_XCC2','XAB2','XAC2','XBC2',
                'CAA2', 'CBB2', 'CCC2', 
                'XAA3','XBB-XCC3','XBB_XCC3','XAB3','XAC3','XBC3',
                'CAA3', 'CBB3', 'CCC3',
                'XAA4','XBB-XCC4','XBB_XCC4','XAB4','XAC4','XBC4',
                'CAA4', 'CBB4', 'CCC4',
                'XAA5','XBB-XCC5','XBB_XCC5','XAB5','XAC5','XBC5',
                'CAA5', 'CBB5', 'CCC5',
                'XAA_P', 'XAA_M', 'XBB-XCC_P', 'XBB-XCC_M', 'XBB_XCC_P', 'XBB_XCC_M',
                'XAB_P', 'XAB_M', 'XAC_P', 'XAC_M', 'XBC_P', 'XBC_M',
                'EAA', 'EBB', 'ECC', 'EAB', 'EBC', 'EAC',
                'CAA_P', 'CAA_M', 'CBB_P', 'CBB_M', 'CCC_P', 'CCC_M',
                'DAA', 'DBB-DCC', 'DBB_DCC',
                'AF', 'TAA', 'TBB-TCC', 'TBB_TCC', 'TBB', 
                'AF2', 'TAA2', 'TBB-TCC2', 'TBB_TCC2', 'TBB2',
                'AF3', 'TAA3', 'TBB-TCC3', 'TBB_TCC3', 'TBB3',
                'AF4', 'TAA4', 'TBB-TCC4', 'TBB_TCC4', 'TBB4',
                'AF5', 'TAA5', 'TBB-TCC5', 'TBB_TCC5', 'TBB5',
                'TAB', 'TAB2', 'TAB3', 'TAB4', 'TAB5',
                'F0', 'V3', 'DELTA', 'EPSILON'
            ]:
                attr = key
                if key == 'DELTAJ': attr = 'dJ'
                elif key == 'DELTAK': attr = 'dK'
                elif key == 'D1': attr = 'd1'
                elif key == 'D2': attr = 'd2'
                elif key in ['XBB-XCC','XBB_XCC']: attr = 'Xbb_Xcc'
                elif key == 'XAA': attr = 'Xaa'
                elif key == 'XAB': attr = 'Xab'   
                elif key == 'XAC': attr = 'Xac'   
                elif key == 'XBC': attr = 'Xbc'   
                elif key in ['XBB-XCC2','XBB_XCC2']: attr = 'Xbb_Xcc2'
                elif key == 'XAA2': attr = 'Xaa2'
                elif key == 'XAB2': attr = 'Xab2'  
                elif key == 'XAC2': attr = 'Xac2'  
                elif key == 'XBC2': attr = 'Xbc2'  
                elif key in ['XBB-XCC3','XBB_XCC3']: attr = 'Xbb_Xcc3'
                elif key == 'XAA3': attr = 'Xaa3'
                elif key == 'XAB3': attr = 'Xab3'  
                elif key == 'XAC3': attr = 'Xac3'  
                elif key == 'XBC3': attr = 'Xbc3'  
                elif key in ['XBB-XCC4','XBB_XCC4']: attr = 'Xbb_Xcc4'
                elif key == 'XAA4': attr = 'Xaa4'
                elif key == 'XAB4': attr = 'Xab4'  
                elif key == 'XAC4': attr = 'Xac4'  
                elif key == 'XBC4': attr = 'Xbc4'  
                elif key in ['XBB-XCC5','XBB_XCC5']: attr = 'Xbb_Xcc5'
                elif key == 'XAA5': attr = 'Xaa5'
                elif key == 'XAB5': attr = 'Xab5'  
                elif key == 'XAC5': attr = 'Xac5'  
                elif key == 'XBC5': attr = 'Xbc5'  
                elif key in ['XBB-XCC_P', 'XBB_XCC_P']: attr = 'Xbb_Xcc_p'
                elif key in ['XBB-XCC_M', 'XBB_XCC_M']: attr = 'Xbb_Xcc_m'
                elif key == 'XAA_P': attr = 'Xaa_p'
                elif key == 'XAA_M': attr = 'Xaa_m'
                elif key == 'XAB_P': attr = 'Xab_p'
                elif key == 'XAB_M': attr = 'Xab_m'
                elif key == 'XAC_P': attr = 'Xac_p'
                elif key == 'XAC_M': attr = 'Xac_m'
                elif key == 'XBC_P': attr = 'Xbc_p'
                elif key == 'XBC_M': attr = 'Xbc_m'
                elif key in ['TBB-TCC', 'TBB_TCC']: attr = 'TBB_TCC'
                elif key in ['TBB-TCC2', 'TBB_TCC2']: attr = 'TBB_TCC2'
                elif key in ['TBB-TCC3', 'TBB_TCC3']: attr = 'TBB_TCC3'
                elif key in ['TBB-TCC4', 'TBB_TCC4']: attr = 'TBB_TCC4'
                elif key in ['TBB-TCC5', 'TBB_TCC5']: attr = 'TBB_TCC5'
                elif key == 'EAA': attr = 'Eaa'
                elif key == 'EBB': attr = 'Ebb'
                elif key == 'ECC': attr = 'Ecc'
                elif key == 'EAB': attr = 'Eab'
                elif key == 'EBC': attr = 'Ebc'
                elif key == 'EAC': attr = 'Eac'
                elif key == 'CAA': attr = 'Caa'
                elif key == 'CBB': attr = 'Cbb'
                elif key == 'CCC': attr = 'Ccc'
                elif key == 'CAA2': attr = 'Caa2'
                elif key == 'CBB2': attr = 'Cbb2'
                elif key == 'CCC2': attr = 'Ccc2'
                elif key == 'CAA3': attr = 'Caa3'
                elif key == 'CBB3': attr = 'Cbb3'
                elif key == 'CCC3': attr = 'Ccc3'
                elif key == 'CAA4': attr = 'Caa4'
                elif key == 'CBB4': attr = 'Cbb4'
                elif key == 'CCC4': attr = 'Ccc4'
                elif key == 'CAA5': attr = 'Caa5'
                elif key == 'CBB5': attr = 'Cbb5'
                elif key == 'CCC5': attr = 'Ccc5'
                elif key == 'CAA_P': attr = 'Caa_p'
                elif key == 'CAA_M': attr = 'Caa_m'
                elif key == 'CBB_P': attr = 'Cbb_p'
                elif key == 'CBB_M': attr = 'Cbb_m'
                elif key == 'CCC_P': attr = 'Ccc_p'
                elif key == 'CCC_M': attr = 'Ccc_m'
                
                try:
                    val_str = parts[1].replace('∓', '-').replace('±', '+')
                    val = float(val_str); flag = 0
                    if len(parts) > 2: flag = int(float(parts[2]))
                    
                    if attr == 'TBB': attr = 'TBB_TCC'; val = 2.0 * val + getattr(P, 'TAA', 0.0)
                    elif attr == 'TBB2': attr = 'TBB_TCC2'; val = 2.0 * val + getattr(P, 'TAA2', 0.0)
                    elif attr == 'TBB3': attr = 'TBB_TCC3'; val = 2.0 * val + getattr(P, 'TAA3', 0.0)
                    elif attr == 'TBB4': attr = 'TBB_TCC4'; val = 2.0 * val + getattr(P, 'TAA4', 0.0)
                    elif attr == 'TBB5': attr = 'TBB_TCC5'; val = 2.0 * val + getattr(P, 'TAA5', 0.0)
                        
                    if hasattr(P, attr): 
                        setattr(P, attr, val)
                        Run.VARY.append((attr, val, flag))
                except: pass
        idx += 1
        
    Run.INIT_A = P.A; Run.INIT_B = P.B; Run.INIT_C = P.C
    for attr, val, flag in Run.VARY:
        if hasattr(Run, f"INIT_{attr}"): setattr(Run, f"INIT_{attr}", getattr(P, attr))
        
    if trans_start != -1:
        num_nuc_spins = len([s for s in P.SPINS if s > 1e-5])
        for line in lines[trans_start+1:]:
            p = line.split()
            if len(p) < 8: continue
            try:
                if P.FORMAT in ['SR', '3SPIN']:
                    if num_nuc_spins == 5 and len(p) >= 20:
                        l = Line(int(p[0]), int(p[1]), int(p[2]), int(p[9]), int(p[10]), int(p[11]), float(p[18]), 1.0, float(p[19]),
                                 J1=float(p[3]), F1_1=float(p[4]), F1_2=float(p[5]), F1_3=float(p[6]), F1_4=float(p[7]), F1=float(p[8]),
                                 J2=float(p[12]), F2_1=float(p[13]), F2_2=float(p[14]), F2_3=float(p[15]), F2_4=float(p[16]), F2=float(p[17]))
                    elif num_nuc_spins == 4 and len(p) >= 18:
                        l = Line(int(p[0]), int(p[1]), int(p[2]), int(p[8]), int(p[9]), int(p[10]), float(p[16]), 1.0, float(p[17]),
                                 J1=float(p[3]), F1_1=float(p[4]), F1_2=float(p[5]), F1_3=float(p[6]), F1=float(p[7]),
                                 J2=float(p[11]), F2_1=float(p[12]), F2_2=float(p[13]), F2_3=float(p[14]), F2=float(p[15]))
                    elif num_nuc_spins == 3 and len(p) >= 16:
                        l = Line(int(p[0]), int(p[1]), int(p[2]), int(p[7]), int(p[8]), int(p[9]), float(p[14]), 1.0, float(p[15]),
                                 J1=float(p[3]), F1_1=float(p[4]), F1_2=float(p[5]), F1=float(p[6]),
                                 J2=float(p[10]), F2_1=float(p[11]), F2_2=float(p[12]), F2=float(p[13]))
                    elif num_nuc_spins == 2 and len(p) >= 14:
                        l = Line(int(p[0]), int(p[1]), int(p[2]), int(p[6]), int(p[7]), int(p[8]), float(p[12]), 1.0, float(p[13]),
                                 J1=float(p[3]), F1_1=float(p[4]), F1=float(p[5]),
                                 J2=float(p[9]), F2_1=float(p[10]), F2=float(p[11]))
                    elif num_nuc_spins <= 1 and len(p) >= 12:
                        l = Line(int(p[0]), int(p[1]), int(p[2]), int(p[5]), int(p[6]), int(p[7]), float(p[10]), 1.0, float(p[11]),
                                 J1=float(p[3]), F1=float(p[4]), J2=float(p[8]), F2=float(p[9]))
                    else: continue
                else: 
                    if num_nuc_spins >= 2 and len(p) >= 12:
                        l = Line(int(p[0]), int(p[1]), int(p[2]), int(p[5]), int(p[6]), int(p[7]), float(p[10]), 1.0, float(p[11]), 
                                 I1=float(p[3]), F1=float(p[4]), I2=float(p[8]), F2=float(p[9]))
                        if len(p) >= 13: l.Sym = int(float(p[12]))
                    elif num_nuc_spins == 1 and len(p) >= 10:
                        l = Line(int(p[0]), int(p[1]), int(p[2]), int(p[4]), int(p[5]), int(p[6]), float(p[8]), 1.0, float(p[9]), 
                                 F1=float(p[3]), F2=float(p[7]))
                        if len(p) >= 11: l.Sym = int(float(p[10]))
                    elif len(p) >= 8:
                        l = Line(int(p[0]), int(p[1]), int(p[2]), int(p[3]), int(p[4]), int(p[5]), float(p[6]), 1.0, float(p[7]))
                        if len(p) >= 9: l.Sym = int(float(p[8]))
                    else: continue

                l.weight = 1.0/(l.error**2) if l.error > 1e-9 else 0.0
                Run.LINES.append(l)
            except: continue
# =================================================================== #
# 4. Pure Rotational Matrix Builders (Base Framework)                 #
# =================================================================== #
def build_matrices(J):
    dim = int(2*J + 1)
    K_vals = np.arange(-J, J+1)
    Jz = np.diag(K_vals)
    Jp = np.zeros((dim, dim), dtype=complex)
    Jm = np.zeros((dim, dim), dtype=complex)
    for i, K in enumerate(K_vals):
        if i+1 < dim: Jp[i+1, i] = math.sqrt((J - K)*(J + K + 1))
        if i-1 >= 0:  Jm[i-1, i] = math.sqrt((J + K)*(J - K + 1))
    Jx = 0.5 * (Jp + Jm)
    Jy = -0.5j * (Jp - Jm)
    return Jx, Jy, Jz, K_vals

def build_rot_hamiltonian(J):
    Jx, Jy, Jz, K_vals = build_matrices(J)
    if getattr(P, 'REP', 'IIIr') == 'IIIr': Ja, Jb, Jc = Jx, Jy, Jz 
    else: Ja, Jb, Jc = Jz, Jx, Jy 
    Ja2 = Ja @ Ja; Jb2 = Jb @ Jb; Jc2 = Jc @ Jc
    J2  = Ja2 + Jb2 + Jc2 
    H_rot = P.A * (Ja2) + P.B * (Jb2) + P.C * (Jc2)
    
    if getattr(P, 'REDUCTION', 'A') == 'A':
        H_rot += -P.DJ * (J2 @ J2) - P.DJK * (J2 @ (Jz @ Jz)) - P.DK * (Jz @ Jz @ Jz @ Jz)
        if abs(getattr(P, 'dJ', 0.0)) > 1e-20: H_rot += -2.0 * P.dJ * (J2 @ (Jx @ Jx - Jy @ Jy))
        if abs(getattr(P, 'dK', 0.0)) > 1e-20: 
            diff2 = Jx @ Jx - Jy @ Jy
            H_rot += -P.dK * (Jz @ Jz @ diff2 + diff2 @ Jz @ Jz)
    elif getattr(P, 'REDUCTION', 'A') == 'S':
        H_rot += -P.DJ * (J2 @ J2) - P.DJK * (J2 @ (Jz @ Jz)) - P.DK * (Jz @ Jz @ Jz @ Jz)
        Jp = Jx + 1j * Jy; Jm = Jx - 1j * Jy; Jp2 = Jp @ Jp; Jm2 = Jm @ Jm
        if abs(getattr(P, 'd1', 0.0)) > 1e-20: H_rot += P.d1 * (J2 @ (Jp2 + Jm2))
        if abs(getattr(P, 'd2', 0.0)) > 1e-20: H_rot += P.d2 * (Jp2 @ Jp2 + Jm2 @ Jm2)
    return H_rot, K_vals

def wang_block_diagonalize(H_rot, J):
    dim = 2 * J + 1
    U = np.zeros((dim, dim), dtype=complex)
    blocks = {'E+': [], 'E-': [], 'O+': [], 'O-': []}

    U[J, 0] = 1.0
    blocks['E+'].append(0)

    col = 1
    for K in range(1, J + 1):
        idx_pos = J + K
        idx_neg = J - K
        
        U[idx_pos, col] = 1.0 / math.sqrt(2.0)
        U[idx_neg, col] = 1.0 / math.sqrt(2.0)
        if K % 2 == 0: blocks['E+'].append(col)
        else: blocks['O+'].append(col)
        col += 1
        
        U[idx_pos, col] = 1.0 / math.sqrt(2.0)
        U[idx_neg, col] = -1.0 / math.sqrt(2.0)
        if K % 2 == 0: blocks['E-'].append(col)
        else: blocks['O-'].append(col)
        col += 1

    H_wang = np.real(U.conj().T @ H_rot @ U)
    w_full = np.zeros(dim)
    v_wang_full = np.zeros((dim, dim))

    for name, indices in blocks.items():
        if not indices: continue
        idx_grid = np.ix_(indices, indices)
        H_sub = H_wang[idx_grid]
        w_sub, v_sub = np.linalg.eigh(H_sub)
        
        for k, global_col in enumerate(indices):
            w_full[global_col] = w_sub[k]
            for r, global_row in enumerate(indices):
                v_wang_full[global_row, global_col] = v_sub[r, k]

    sort_idx = np.argsort(w_full)
    w_sorted = w_full[sort_idx]
    v_wang_sorted = v_wang_full[:, sort_idx]
    v_full = U @ v_wang_sorted
    return w_sorted, v_full

def get_asym_top_rot(K1, K2, N):
    if N < 0: return 0.0
    val = 0.0
    if K1 == K2:
        val += P.A * K1**2 + 0.5 * (P.B + P.C) * (N * (N + 1) - K1**2)
        if getattr(P, 'REDUCTION', 'A') in ['A', 'S']:
            val -= P.DJ * (N * (N+1))**2
            val -= P.DJK * N * (N+1) * K1**2
            val -= P.DK * K1**4
    elif abs(K1 - K2) == 2:
        f_n_k = math.sqrt((N - max(K1, K2) + 1) * (N - max(K1, K2) + 2) * (N + max(K1, K2) - 1) * (N + max(K1, K2)))
        val += 0.25 * (P.B - P.C) * f_n_k
        if getattr(P, 'REDUCTION', 'A') == 'A':
            val -= (getattr(P, 'dJ', 0.0) * N * (N+1) + 0.5 * getattr(P, 'dK', 0.0) * (K1**2 + K2**2)) * f_n_k
        elif P.REDUCTION == 'S':
            val += getattr(P, 'd1', 0.0) * N * (N+1) * f_n_k
    elif abs(K1 - K2) == 4 and getattr(P, 'REDUCTION', 'A') == 'S':
        k_m = max(K1, K2)
        f1 = math.sqrt((N - k_m + 1)*(N - k_m + 2)*(N + k_m - 1)*(N + k_m))
        f2 = math.sqrt((N - k_m + 3)*(N - k_m + 4)*(N + k_m - 3)*(N + k_m - 2))
        val += getattr(P, 'd2', 0.0) * f1 * f2
    return val

# =================================================================== #
# 5. Core Cartesian Spin-Rotation, Hyperfine, & Internal Rotor        #
# =================================================================== #
def calculate_internal_rotor_constants():
    if not hasattr(P, 'F0') or P.F0 < 1e-9:
        P.F = 0.0; P.RHO_a = 0.0; P.RHO_b = 0.0; P.I_ALPHA = 0.0
        return
    CONV = 505379.010 
    P.I_ALPHA = CONV / (P.F0 * 1000.0)
    Ia = CONV / P.A if P.A > 1e-9 else 1e10
    Ib = CONV / P.B if P.B > 1e-9 else 1e10
    Ic = CONV / P.C if P.C > 1e-9 else 1e10
    
    delta_rad = math.radians(getattr(P, 'DELTA', 0.0))
    epsilon_rad = math.radians(getattr(P, 'EPSILON', 0.0))
    
    la = math.cos(delta_rad)
    lb = math.sin(delta_rad) * math.cos(epsilon_rad)
    lc = math.sin(delta_rad) * math.sin(epsilon_rad)
    
    P.RHO_a = la * (P.I_ALPHA / Ia)
    P.RHO_b = lb * (P.I_ALPHA / Ib)
    rho_c   = lc * (P.I_ALPHA / Ic)
    
    r = 1.0 - (P.RHO_a * la + P.RHO_b * lb + rho_c * lc)
    if r > 1e-9: P.F = P.F0 / r 
    else: P.F = 0.0

def solve_1d_torsion_iam(sigma, K, F, V3, rho, m_max=15, fold=3):
    k_vals = np.arange(-m_max, m_max + 1)
    m_vals = fold * k_vals + sigma
    dim = len(k_vals)
    H_tor = np.zeros((dim, dim))
    for i in range(dim):
        H_tor[i, i] = F * ((m_vals[i] - rho * K)**2)
        if i + 1 < dim: H_tor[i, i+1] = -V3 / 4.0
        if i - 1 >= 0:  H_tor[i, i-1] = -V3 / 4.0
    return np.linalg.eigh(H_tor)

def build_iam_hamiltonian(J, sigma):
    H_rot, K_vals = build_rot_hamiltonian(J) 
    vt_max = getattr(P, 'VT_MAX', 1) 
    dim_rot = 2 * J + 1
    dim_tot = dim_rot * vt_max
    
    H_total = np.zeros((dim_tot, dim_tot), dtype=complex)
    tor_energies = {}; tor_evecs = {}
    
    for K in K_vals:
        evals, evecs = solve_1d_torsion_iam(sigma, K, P.F, P.V3, P.RHO_a)
        tor_energies[K] = evals[:vt_max]
        tor_evecs[K] = evecs[:, :vt_max] 
        
    for i, K1 in enumerate(K_vals):
        for j, K2 in enumerate(K_vals):
            rot_val = H_rot[i, j]
            if abs(rot_val) < 1e-12 and i != j: continue
            overlap = tor_evecs[K1].T @ tor_evecs[K2]
            row_start = i * vt_max; col_start = j * vt_max
            H_total[row_start:row_start+vt_max, col_start:col_start+vt_max] += rot_val * overlap
            if i == j: H_total[row_start:row_start+vt_max, col_start:col_start+vt_max] += np.diag(tor_energies[K1])
                
    return H_total, dim_rot, vt_max

def calc_spin_rotation(N, K1, K2, J, S):
    if J < 0 or N == 0: return 0.0
    n_dot_s = 0.5 * (J*(J+1) - N*(N+1) - S*(S+1))
    factor = n_dot_s / (N * (N + 1))
    
    val = 0.0
    if K1 == K2:
        val += P.Eaa * K1**2 + 0.5 * (P.Ebb + P.Ecc) * (N * (N + 1) - K1**2)
    elif abs(K1 - K2) == 2:
        f_n_k = math.sqrt((N - max(K1, K2) + 1) * (N - max(K1, K2) + 2) * (N + max(K1, K2) - 1) * (N + max(K1, K2)))
        val += 0.25 * (P.Ebb - P.Ecc) * f_n_k
    elif abs(K1 - K2) == 1:
        k_min = min(K1, K2)
        val += 0.5 * P.Eab * (2*k_min + 1) * math.sqrt(N*(N+1) - k_min*(k_min+1))
    return val * factor

def calc_J_V1_J(N1, K1, J1, N2, K2, J2, S, aF, Taa, Tbb_Tcc, Tab):
    fermi_val = 0.0
    if N1 == N2 and K1 == K2:
        w6j = wigner6j(S, J1, N1, J2, S, 1)
        if abs(w6j) > 1e-12:
            fermi_val = aF * ((-1)**(N1 + S + J2 + 1)) * math.sqrt((2*J1+1)*(2*J2+1)) * w6j * math.sqrt(S*(S+1)*(2*S+1))
            
    dipole_val = 0.0
    if abs(N1 - N2) <= 2:
        red_T2 = 0.0
        phase_N = (-1)**(N1 - K1)
        prefac_N = math.sqrt((2*N1+1)*(2*N2+1))
        if K1 == K2:
            w3j = wigner3j(N1, 2, N2, -K1, 0, K2)
            if abs(w3j) > 1e-12: red_T2 += phase_N * prefac_N * w3j * Taa
        elif abs(K1 - K2) == 2:
            w3j = wigner3j(N1, 2, N2, -K1, K1 - K2, K2)
            if abs(w3j) > 1e-12: red_T2 += phase_N * prefac_N * w3j * (Tbb_Tcc / math.sqrt(6.0))
        elif abs(K1 - K2) == 1 and abs(Tab) > 1e-9:
            q = K1 - K2
            w3j = wigner3j(N1, 2, N2, -K1, q, K2)
            if abs(w3j) > 1e-12:
                T2_q = -Tab if q == 1 else Tab
                red_T2 += phase_N * prefac_N * w3j * T2_q * math.sqrt(2.0/3.0)

        if abs(red_T2) > 1e-12:
            w9j = wigner9j(N1, S, J1, N2, S, J2, 2, 1, 1)
            if abs(w9j) > 1e-12:
                dipole_val = math.sqrt(3.0) * math.sqrt((2*J1+1)*(2*J2+1)) * w9j * red_T2 * math.sqrt(S*(S+1)*(2*S+1))
    return fermi_val + dipole_val

def calc_Q_rot(k1, k2, j1, j2, Xaa, Xbb_Xcc):
    if abs(j1 - j2) > 2: return 0.0
    C0_0 = Xaa / 2.0; C2_0 = Xaa / 2.0; C2_2 = Xbb_Xcc / 4.0
    val = 0.0
    if k1 == k2:
        val += C0_0 * wigner3j(j1, 0.0, j2, -k1, 0, k2) if j1 == j2 else 0.0
        val += C2_0 * wigner3j(j1, 2.0, j2, -k1, 0, k2)
    elif abs(k1 - k2) == 2:
        val += C2_2 * wigner3j(j1, 2.0, j2, -k1, k1 - k2, k2)
    return val * math.sqrt((2.0*j1+1)*(2.0*j2+1))

@functools.lru_cache(maxsize=None)
def get_quadrupole_geometric_matrices(j1, j2):
    dim1 = 2*j1 + 1; dim2 = 2*j2 + 1
    M_geom = {q: np.zeros((dim1, dim2), dtype=float) for q in [0, 1, -1, 2, -2]}
    sqrt_j1_j2 = math.sqrt((2*j2 + 1)*(2*j1 + 1))
    
    for idx1, k1 in enumerate(range(-j1, j1+1)):
        for idx2, k2 in enumerate(range(-j2, j2+1)):
            q = k1 - k2
            if abs(q) > 2: continue
            tj = wigner3j(j1, 2.0, j2, -k1, q, k2)
            if abs(tj) < 1e-12: continue
            sign_K = 1 if int(round(j1 - k1)) % 2 == 0 else -1
            M_geom[q][idx1, idx2] = 0.5 * sqrt_j1_j2 * sign_K * tj
    return M_geom

def build_quadrupole_block(j1, j2, I_a, I_b, F):
    dim1 = 2*j1 + 1; dim2 = 2*j2 + 1
    HQ = np.zeros((dim1, dim2), dtype=complex)
    if len(P.SPINS) == 0: return HQ
    I1 = P.SPINS[0]
    I2 = P.SPINS[1] if len(P.SPINS) > 1 else 0.0
    
    def get_T_dict(xaa, xbb_xcc, xab, xac, xbc):
        xbb = -0.5*xaa + 0.5*xbb_xcc; xcc = -0.5*xaa - 0.5*xbb_xcc
        if P.REP == 'IIIr':
            chi_zz, chi_xx, chi_yy = xcc, xaa, xbb
            chi_xz, chi_yz, chi_xy = xac, xbc, xab
        else:
            chi_zz, chi_xx, chi_yy = xaa, xbb, xcc
            chi_xz, chi_yz, chi_xy = xab, xac, xbc
        return {
            0: 0.5 * chi_zz, 1: -(chi_xz + 1j * chi_yz) / math.sqrt(6.0), -1:  (chi_xz - 1j * chi_yz) / math.sqrt(6.0),
            2:  (chi_xx - chi_yy + 2j * chi_xy) / math.sqrt(24.0), -2:  (chi_xx - chi_yy - 2j * chi_xy) / math.sqrt(24.0)
        }

    M_geom = get_quadrupole_geometric_matrices(j1, j2)
    sixj_F = wigner6j(j1, j2, 2.0, I_b, I_a, F)
    if abs(sixj_F) < 1e-12: return HQ

    if I1 >= 1.0 and (abs(P.Xaa) > 1e-9 or abs(P.Xbb_Xcc) > 1e-9):
        norm1 = math.sqrt(((2*I1+3)*(2*I1+1)*(I1+1))/(I1*(2*I1-1)))
        if I2 > 0:
            spin_factor = (-1.0)**(I1 + I2 + I_a + 2.0) * math.sqrt((2.0*I_a + 1.0)*(2.0*I_b + 1.0)) * \
                          wigner6j(I_a, 2.0, I_b, I1, I2, I1) * norm1
        else:
            spin_factor = norm1 if I_a == I_b else 0.0
            
        prefactor1 = (-1.0)**(j1 + I_b + F) * sixj_F * spin_factor
        if abs(prefactor1) > 1e-12:
            T1 = get_T_dict(P.Xaa, P.Xbb_Xcc, P.Xab, P.Xac, P.Xbc)
            for q in [0, 1, -1, 2, -2]:
                if abs(T1[q]) > 1e-12: HQ += M_geom[q] * (T1[q] * prefactor1)

    if I2 >= 1.0 and (abs(P.Xaa2) > 1e-9 or abs(P.Xbb_Xcc2) > 1e-9):
        norm2 = math.sqrt(((2*I2+3)*(2*I2+1)*(I2+1))/(I2*(2*I2-1)))
        spin_factor2 = (-1.0)**(I1 + I2 + I_b + 2.0) * math.sqrt((2.0*I_a + 1.0)*(2.0*I_b + 1.0)) * \
                       wigner6j(I_a, 2.0, I_b, I2, I1, I2) * norm2
                       
        prefactor2 = (-1.0)**(j1 + I_b + F) * sixj_F * spin_factor2
        if abs(prefactor2) > 1e-12:
            T2 = get_T_dict(P.Xaa2, P.Xbb_Xcc2, P.Xab2, P.Xac2, P.Xbc2)
            for q in [0, 1, -1, 2, -2]:
                if abs(T2[q]) > 1e-12: HQ += M_geom[q] * (T2[q] * prefactor2)

    return HQ

def build_spin_rotation_block(j1, j2, I_a, I_b, F):
    dim1 = int(2*j1 + 1); dim2 = int(2*j2 + 1)
    matrix = np.zeros((dim1, dim2), dtype=complex)
    if len(P.SPINS) == 0: return matrix
    I1 = P.SPINS[0]; I2 = P.SPINS[1] if len(P.SPINS) > 1 else 0.0

    if abs(P.Caa) > 1e-9 or abs(P.Cbb) > 1e-9 or abs(P.Ccc) > 1e-9:
        C0_0 = -(P.Caa + P.Cbb + P.Ccc) / math.sqrt(3.0)
        C2_0 = (2.0 * P.Caa - P.Cbb - P.Ccc) / math.sqrt(6.0)
        C2_2 = (P.Cbb - P.Ccc) / 2.0
        spin_rmel = math.sqrt(I1 * (I1 + 1.0) * (2.0 * I1 + 1.0))
        
        if I2 > 0:
            spin_factor = (-1.0)**(I1 + I2 + I_a + 1.0) * math.sqrt((2.0*I_a + 1.0)*(2.0*I_b + 1.0)) * \
                          wigner6j(I_a, 1.0, I_b, I1, I2, I1) * spin_rmel
        else:
            spin_factor = spin_rmel if I_a == I_b else 0.0
            
        prefactor = (-1.0)**(j1 + I_b + F) * wigner6j(j1, j2, 1.0, I_b, I_a, F) * spin_factor
        
        if abs(prefactor) > 1e-12:
            sqrt_j1_j2 = math.sqrt((2.0*j1+1)*(2.0*j2+1))
            for i in range(dim1):
                K = i - j1
                for j in range(dim2):
                    K_prime = j - j2
                    if K == K_prime:
                        t0 = C0_0 * wigner3j(j1, 0.0, j2, -K, 0, K_prime) if j1 == j2 else 0.0
                        matrix[i, j] += prefactor * (t0 + C2_0 * wigner3j(j1, 2.0, j2, -K, 0, K_prime)) * sqrt_j1_j2
                    elif abs(K - K_prime) == 2:
                        matrix[i, j] += prefactor * C2_2 * wigner3j(j1, 2.0, j2, -K, K - K_prime, K_prime) * sqrt_j1_j2

    if I2 > 0 and (abs(P.Caa2) > 1e-9 or abs(P.Cbb2) > 1e-9 or abs(P.Ccc2) > 1e-9):
        C0_0 = -(P.Caa2 + P.Cbb2 + P.Ccc2) / math.sqrt(3.0)
        C2_0 = (2.0 * P.Caa2 - P.Cbb2 - P.Ccc2) / math.sqrt(6.0)
        C2_2 = (P.Cbb2 - P.Ccc2) / 2.0
        spin_rmel2 = math.sqrt(I2 * (I2 + 1.0) * (2.0 * I2 + 1.0))
        spin_factor2 = (-1.0)**(I1 + I2 + I_b + 1.0) * math.sqrt((2.0*I_a + 1.0)*(2.0*I_b + 1.0)) * \
                       wigner6j(I_a, 1.0, I_b, I2, I1, I2) * spin_rmel2
                       
        prefactor2 = (-1.0)**(j1 + I_b + F) * wigner6j(j1, j2, 1.0, I_b, I_a, F) * spin_factor2
        
        if abs(prefactor2) > 1e-12:
            sqrt_j1_j2 = math.sqrt((2.0*j1+1)*(2.0*j2+1))
            for i in range(dim1):
                K = i - j1
                for j in range(dim2):
                    K_prime = j - j2
                    if K == K_prime:
                        t0 = C0_0 * wigner3j(j1, 0.0, j2, -K, 0, K_prime) if j1 == j2 else 0.0
                        matrix[i, j] += prefactor2 * (t0 + C2_0 * wigner3j(j1, 2.0, j2, -K, 0, K_prime)) * sqrt_j1_j2
                    elif abs(K - K_prime) == 2:
                        matrix[i, j] += prefactor2 * C2_2 * wigner3j(j1, 2.0, j2, -K, K - K_prime, K_prime) * sqrt_j1_j2

    return matrix

def build_spin_spin_block(j1, j2, I_a, I_b, F):
    dim1 = int(2*j1 + 1); dim2 = int(2*j2 + 1)
    matrix = np.zeros((dim1, dim2), dtype=complex)
    if len(P.SPINS) < 2: return matrix
    I1 = P.SPINS[0]; I2 = P.SPINS[1]

    if abs(P.Daa) < 1e-9 and abs(P.Dbb_Dcc) < 1e-9: return matrix

    D2_0 = P.Daa * math.sqrt(3.0 / 2.0); D2_2 = P.Dbb_Dcc / 2.0
    rmel_1 = math.sqrt(I1 * (I1 + 1.0) * (2.0 * I1 + 1.0))
    rmel_2 = math.sqrt(I2 * (I2 + 1.0) * (2.0 * I2 + 1.0))
    
    nine_j_val = wigner9j(I1, I1, 1.0, I2, I2, 1.0, I_a, I_b, 2.0)
    spin_factor = math.sqrt(5.0) * math.sqrt((2.0*I_a + 1.0)*(2.0*I_b + 1.0)) * \
                  nine_j_val * rmel_1 * rmel_2
                  
    space_factor = (-1.0)**(j1 + I_b + F) * wigner6j(j1, j2, 2.0, I_b, I_a, F)
    total_prefactor = spin_factor * space_factor
    
    if abs(total_prefactor) > 1e-12:
        sqrt_j1_j2 = math.sqrt((2.0*j1+1)*(2.0*j2+1))
        for i in range(dim1):
            K = i - j1
            for j in range(dim2):
                K_prime = j - j2
                if K == K_prime:
                    term = D2_0 * wigner3j(j1, 2.0, j2, -K, 0, K_prime)
                    matrix[i, j] += total_prefactor * term * sqrt_j1_j2
                elif abs(K - K_prime) == 2:
                    q = K - K_prime
                    term = D2_2 * wigner3j(j1, 2.0, j2, -K, q, K_prime)
                    matrix[i, j] += total_prefactor * term * sqrt_j1_j2

    return matrix

# =================================================================== #
# 6. Uncoupled Basis Matrix Constructor                               #
# =================================================================== #
def generate_uncoupled_basis(N: float, F_tot: float) -> tuple:
    basis = []
    S = getattr(P, 'S', 0.5)
    
    # Safely load up to 5 nuclear spins
    I1 = P.SPINS[0] if len(P.SPINS) > 0 else 0.0
    I2 = P.SPINS[1] if len(P.SPINS) > 1 else 0.0
    I3 = P.SPINS[2] if len(P.SPINS) > 2 else 0.0
    I4 = P.SPINS[3] if len(P.SPINS) > 3 else 0.0
    I5 = P.SPINS[4] if len(P.SPINS) > 4 else 0.0
    
    for k_val in range(-int(N), int(N) + 1):
        if P.FORMAT == 'SR':
            j_vals = list(set([N + S, abs(N - S)]))
            for j in j_vals:
                if len(P.SPINS) == 0:
                    if F_tot < 0 or j == F_tot: 
                        basis.append({'N': N, 'K': k_val, 'j': j, 'F5': j})
                        
                elif len(P.SPINS) == 1:
                    for F1 in np.arange(abs(j - I1), j + I1 + 1):
                        if F_tot < 0 or F1 == F_tot:
                            basis.append({'N': N, 'K': k_val, 'j': j, 'F1': F1, 'F5': F1})
                            
                elif len(P.SPINS) == 2:
                    for F1 in np.arange(abs(j - I1), j + I1 + 1):
                        for F2 in np.arange(abs(F1 - I2), F1 + I2 + 1):
                            if F_tot < 0 or F2 == F_tot:
                                basis.append({'N': N, 'K': k_val, 'j': j, 'F1': F1, 'F2': F2, 'F5': F2})
                                
                elif len(P.SPINS) == 3:
                    for F1 in np.arange(abs(j - I1), j + I1 + 1):
                        for F2 in np.arange(abs(F1 - I2), F1 + I2 + 1):
                            for F3 in np.arange(abs(F2 - I3), F2 + I3 + 1):
                                if F_tot < 0 or F3 == F_tot:
                                    basis.append({'N': N, 'K': k_val, 'j': j, 'F1': F1, 'F2': F2, 'F3': F3, 'F5': F3})
                                    
                elif len(P.SPINS) == 4:
                    for F1 in np.arange(abs(j - I1), j + I1 + 1):
                        for F2 in np.arange(abs(F1 - I2), F1 + I2 + 1):
                            for F3 in np.arange(abs(F2 - I3), F2 + I3 + 1):
                                for F4 in np.arange(abs(F3 - I4), F3 + I4 + 1):
                                    if F_tot < 0 or F4 == F_tot:
                                        basis.append({'N': N, 'K': k_val, 'j': j, 'F1': F1, 'F2': F2, 'F3': F3, 'F4': F4, 'F5': F4})
                                        
                elif len(P.SPINS) == 5:
                    for F1 in np.arange(abs(j - I1), j + I1 + 1):
                        for F2 in np.arange(abs(F1 - I2), F1 + I2 + 1):
                            for F3 in np.arange(abs(F2 - I3), F2 + I3 + 1):
                                for F4 in np.arange(abs(F3 - I4), F3 + I4 + 1):
                                    for F5 in np.arange(abs(F4 - I5), F4 + I5 + 1):
                                        if F_tot < 0 or F5 == F_tot:
                                            basis.append({'N': N, 'K': k_val, 'j': j, 'F1': F1, 'F2': F2, 'F3': F3, 'F4': F4, 'F5': F5})
                                        
        elif P.FORMAT == '3SPIN': 
            if len(P.SPINS) == 3:
                for F1 in np.arange(abs(N - I1), N + I1 + 1):
                    for F2 in np.arange(abs(F1 - I2), F1 + I2 + 1):
                        for F3 in np.arange(abs(F2 - I3), F2 + I3 + 1):
                            if F_tot < 0 or F3 == F_tot:
                                basis.append({'N': N, 'K': k_val, 'F1': F1, 'F2': F2, 'F3': F3, 'F5': F3})
            elif len(P.SPINS) == 4:
                for F1 in np.arange(abs(N - I1), N + I1 + 1):
                    for F2 in np.arange(abs(F1 - I2), F1 + I2 + 1):
                        for F3 in np.arange(abs(F2 - I3), F2 + I3 + 1):
                            for F4 in np.arange(abs(F3 - I4), F3 + I4 + 1):
                                if F_tot < 0 or F4 == F_tot:
                                    basis.append({'N': N, 'K': k_val, 'F1': F1, 'F2': F2, 'F3': F3, 'F4': F4, 'F5': F4})
            elif len(P.SPINS) == 5:
                for F1 in np.arange(abs(N - I1), N + I1 + 1):
                    for F2 in np.arange(abs(F1 - I2), F1 + I2 + 1):
                        for F3 in np.arange(abs(F2 - I3), F2 + I3 + 1):
                            for F4 in np.arange(abs(F3 - I4), F3 + I4 + 1):
                                for F5 in np.arange(abs(F4 - I5), F4 + I5 + 1):
                                    if F_tot < 0 or F5 == F_tot:
                                        basis.append({'N': N, 'K': k_val, 'F1': F1, 'F2': F2, 'F3': F3, 'F4': F4, 'F5': F5})
                                    
    return basis

def build_uncoupled_hamiltonian(basis):
    dim = len(basis)
    H_tot = np.zeros((dim, dim), dtype=complex)
    S = getattr(P, 'S', 0.5)
    
    # Safely load up to 5 nuclear spins
    I1 = P.SPINS[0] if len(P.SPINS) > 0 else 0.0
    I2 = P.SPINS[1] if len(P.SPINS) > 1 else 0.0
    I3 = P.SPINS[2] if len(P.SPINS) > 2 else 0.0
    I4 = P.SPINS[3] if len(P.SPINS) > 3 else 0.0
    I5 = P.SPINS[4] if len(P.SPINS) > 4 else 0.0
    
    def I_mag(I_val): return math.sqrt(I_val*(I_val+1)*(2*I_val+1)) if I_val > 0 else 0.0

    for i in range(dim):
        # Extract based on available spins
        b1 = basis[i]
        n1, j1, k1 = b1['N'] if 'N' in b1 else b1.get('j', 0), b1.get('j', 0), b1.get('K', 0)
        f1_1 = b1.get('F1', b1.get('F', 0))
        f2_1 = b1.get('F2', b1.get('F', 0))
        f3_1 = b1.get('F3', b1.get('F', 0))
        f4_1 = b1.get('F4', b1.get('F', 0))
        f_1  = b1.get('F5', b1.get('F4', b1.get('F3', b1.get('F2', b1.get('F1', b1.get('j', 0))))))

        for j in range(dim):
            b2 = basis[j]
            n2, j2, k2 = b2['N'] if 'N' in b2 else b2.get('j', 0), b2.get('j', 0), b2.get('K', 0)
            f1_2 = b2.get('F1', b2.get('F', 0))
            f2_2 = b2.get('F2', b2.get('F', 0))
            f3_2 = b2.get('F3', b2.get('F', 0))
            f4_2 = b2.get('F4', b2.get('F', 0))
            f_2  = b2.get('F5', b2.get('F4', b2.get('F3', b2.get('F2', b2.get('F1', b2.get('j', 0))))))
            
            if f_1 != f_2: continue
            
            # Pure Asymmetric Top Rotation
            if j1 == j2 and f1_1 == f1_2 and f2_1 == f2_2 and f3_1 == f3_2 and f4_1 == f4_2 and n1 == n2:
                H_tot[i, j] += get_asym_top_rot(k1, k2, n1)
                
            # Exact Cartesian Spin Rotation
            if f1_1 == f1_2 and f2_1 == f2_2 and f3_1 == f3_2 and f4_1 == f4_2 and P.FORMAT == 'SR':
                if n1 == n2:
                    H_tot[i, j] += calc_spin_rotation(n1, k1, k2, j1, S)
                
            # Hyperfine Rank 1 Elements (Spin-Rotation / Fermi Contact)
            red_V1_s1 = calc_J_V1_J(n1, k1, j1, n2, k2, j2, S, P.AF, P.TAA, P.TBB_TCC, P.TAB) if P.FORMAT == 'SR' else 0.0
            red_V1_s2 = calc_J_V1_J(n1, k1, j1, n2, k2, j2, S, P.AF2, P.TAA2, P.TBB_TCC2, P.TAB2) if P.FORMAT == 'SR' else 0.0
            red_V1_s3 = calc_J_V1_J(n1, k1, j1, n2, k2, j2, S, P.AF3, P.TAA3, P.TBB_TCC3, P.TAB3) if P.FORMAT == 'SR' else 0.0
            red_V1_s4 = calc_J_V1_J(n1, k1, j1, n2, k2, j2, S, P.AF4, P.TAA4, P.TBB_TCC4, P.TAB4) if P.FORMAT == 'SR' else 0.0
            red_V1_s5 = calc_J_V1_J(n1, k1, j1, n2, k2, j2, S, P.AF5, P.TAA5, P.TBB_TCC5, getattr(P, 'TAB5', 0.0)) if P.FORMAT == 'SR' else 0.0
            
            # Hyperfine Quadrupole for 3SPIN format (Extended to 5 spins)
            if P.FORMAT == '3SPIN':
                # Spin 1
                if I1 > 0 and f2_1 == f2_2 and f3_1 == f3_2 and f4_1 == f4_2:
                    R1 = calc_Q_rot(k1, k2, j1, j2, P.Xaa, P.Xbb_Xcc)
                    if abs(R1) > 1e-12: H_tot[i, j] += ((-1)**(I1 + j2 + f1_1)) * wigner6j(I1, j1, f1_1, j2, I1, 2.0) * R1
                
                # Spin 2
                if I2 > 0 and f1_1 != 0 and f1_2 != 0 and f3_1 == f3_2 and f4_1 == f4_2:
                    R2 = calc_Q_rot(k1, k2, j1, j2, getattr(P, 'Xaa2', 0.0), getattr(P, 'Xbb_Xcc2', 0.0))
                    if abs(R2) > 1e-12:
                        red_F1 = ((-1)**(j1 + I1 + f1_2)) * math.sqrt((2*f1_1+1)*(2*f1_2+1)) * wigner6j(j1, f1_1, I1, f1_2, j2, 2.0) * R2
                        H_tot[i, j] += ((-1)**(I2 + f1_2 + f2_1)) * wigner6j(I2, f1_1, f2_1, f1_2, I2, 2.0) * red_F1
                
                # Spin 3
                if I3 > 0 and f1_1 != 0 and f1_2 != 0 and f2_1 != 0 and f2_2 != 0 and f4_1 == f4_2:
                    R3 = calc_Q_rot(k1, k2, j1, j2, getattr(P, 'Xaa3', 0.0), getattr(P, 'Xbb_Xcc3', 0.0))
                    if abs(R3) > 1e-12:
                        red_F1 = ((-1)**(j1 + I1 + f1_2)) * math.sqrt((2*f1_1+1)*(2*f1_2+1)) * wigner6j(j1, f1_1, I1, f1_2, j2, 2.0) * R3
                        red_F2 = ((-1)**(f1_1 + I2 + f2_2)) * math.sqrt((2*f2_1+1)*(2*f2_2+1)) * wigner6j(f1_1, f2_1, I2, f2_2, f1_2, 2.0) * red_F1
                        H_tot[i, j] += ((-1)**(I3 + f2_2 + f3_1)) * wigner6j(I3, f2_1, f3_1, f2_2, I3, 2.0) * red_F2
                
                # Spin 4
                if I4 > 0 and f1_1 != 0 and f1_2 != 0 and f2_1 != 0 and f2_2 != 0 and f3_1 != 0 and f3_2 != 0:
                    R4 = calc_Q_rot(k1, k2, j1, j2, getattr(P, 'Xaa4', 0.0), getattr(P, 'Xbb_Xcc4', 0.0))
                    if abs(R4) > 1e-12:
                        red_F1 = ((-1)**(j1 + I1 + f1_2)) * math.sqrt((2*f1_1+1)*(2*f1_2+1)) * wigner6j(j1, f1_1, I1, f1_2, j2, 2.0) * R4
                        red_F2 = ((-1)**(f1_1 + I2 + f2_2)) * math.sqrt((2*f2_1+1)*(2*f2_2+1)) * wigner6j(f1_1, f2_1, I2, f2_2, f1_2, 2.0) * red_F1
                        red_F3 = ((-1)**(f2_1 + I3 + f3_2)) * math.sqrt((2*f3_1+1)*(2*f3_2+1)) * wigner6j(f2_1, f3_1, I3, f3_2, f2_2, 2.0) * red_F2
                        H_tot[i, j] += ((-1)**(I4 + f3_2 + f4_1)) * wigner6j(I4, f3_1, f4_1, f3_2, I4, 2.0) * red_F3
                
                # Spin 5
                if I5 > 0 and f1_1 != 0 and f1_2 != 0 and f2_1 != 0 and f2_2 != 0 and f3_1 != 0 and f3_2 != 0 and f4_1 != 0 and f4_2 != 0:
                    R5 = calc_Q_rot(k1, k2, j1, j2, getattr(P, 'Xaa5', 0.0), getattr(P, 'Xbb_Xcc5', 0.0))
                    if abs(R5) > 1e-12:
                        red_F1 = ((-1)**(j1 + I1 + f1_2)) * math.sqrt((2*f1_1+1)*(2*f1_2+1)) * wigner6j(j1, f1_1, I1, f1_2, j2, 2.0) * R5
                        red_F2 = ((-1)**(f1_1 + I2 + f2_2)) * math.sqrt((2*f2_1+1)*(2*f2_2+1)) * wigner6j(f1_1, f2_1, I2, f2_2, f1_2, 2.0) * red_F1
                        red_F3 = ((-1)**(f2_1 + I3 + f3_2)) * math.sqrt((2*f3_1+1)*(2*f3_2+1)) * wigner6j(f2_1, f3_1, I3, f3_2, f2_2, 2.0) * red_F2
                        red_F4 = ((-1)**(f3_1 + I4 + f4_2)) * math.sqrt((2*f4_1+1)*(2*f4_2+1)) * wigner6j(f3_1, f4_1, I4, f4_2, f3_2, 2.0) * red_F3
                        H_tot[i, j] += ((-1)**(I5 + f4_2 + f_1)) * wigner6j(I5, f4_1, f_1, f4_2, I5, 2.0) * red_F4

            # Spin-Rotation Rank 1 Tensor Evaluation
            # Spin 1
            if I1 > 0 and f2_1 == f2_2 and f3_1 == f3_2 and f4_1 == f4_2 and abs(red_V1_s1) > 1e-12:
                w6j = wigner6j(j1, I1, f1_1, I1, j2, 1)
                H_tot[i, j] += ((-1)**(j2 + I1 + f1_1)) * w6j * red_V1_s1 * I_mag(I1)
            
            # Spin 2
            if I2 > 0 and f1_1 != 0 and f1_2 != 0 and f3_1 == f3_2 and f4_1 == f4_2 and abs(red_V1_s2) > 1e-12:
                red_F1 = ((-1)**(j1 + I1 + f1_2 + 1)) * math.sqrt((2*f1_1+1)*(2*f1_2+1)) * wigner6j(j1, f1_1, I1, f1_2, j2, 1) * red_V1_s2
                if abs(red_F1) > 1e-12:
                    H_tot[i, j] += ((-1)**(f1_2 + I2 + f2_1)) * wigner6j(f1_1, I2, f2_1, I2, f1_2, 1) * red_F1 * I_mag(I2)
            
            # Spin 3
            if I3 > 0 and f1_1 != 0 and f1_2 != 0 and f2_1 != 0 and f2_2 != 0 and f4_1 == f4_2 and abs(red_V1_s3) > 1e-12:
                red_F1 = ((-1)**(j1 + I1 + f1_2 + 1)) * math.sqrt((2*f1_1+1)*(2*f1_2+1)) * wigner6j(j1, f1_1, I1, f1_2, j2, 1) * red_V1_s3
                if abs(red_F1) > 1e-12:
                    red_F2 = ((-1)**(f1_1 + I2 + f2_2 + 1)) * math.sqrt((2*f2_1+1)*(2*f2_2+1)) * wigner6j(f1_1, f2_1, I2, f2_2, f1_2, 1) * red_F1
                    if abs(red_F2) > 1e-12:
                        H_tot[i, j] += ((-1)**(f2_2 + I3 + f3_1)) * wigner6j(f2_1, I3, f3_1, I3, f2_2, 1) * red_F2 * I_mag(I3)

            # Spin 4
            if I4 > 0 and f1_1 != 0 and f1_2 != 0 and f2_1 != 0 and f2_2 != 0 and f3_1 != 0 and f3_2 != 0 and abs(red_V1_s4) > 1e-12:
                red_F1 = ((-1)**(j1 + I1 + f1_2 + 1)) * math.sqrt((2*f1_1+1)*(2*f1_2+1)) * wigner6j(j1, f1_1, I1, f1_2, j2, 1) * red_V1_s4
                if abs(red_F1) > 1e-12:
                    red_F2 = ((-1)**(f1_1 + I2 + f2_2 + 1)) * math.sqrt((2*f2_1+1)*(2*f2_2+1)) * wigner6j(f1_1, f2_1, I2, f2_2, f1_2, 1) * red_F1
                    if abs(red_F2) > 1e-12:
                        red_F3 = ((-1)**(f2_1 + I3 + f3_2 + 1)) * math.sqrt((2*f3_1+1)*(2*f3_2+1)) * wigner6j(f2_1, f3_1, I3, f3_2, f2_2, 1) * red_F2
                        if abs(red_F3) > 1e-12:
                            H_tot[i, j] += ((-1)**(f3_2 + I4 + f4_1)) * wigner6j(f3_1, I4, f4_1, I4, f3_2, 1) * red_F3 * I_mag(I4)

            # Spin 5
            if I5 > 0 and f1_1 != 0 and f1_2 != 0 and f2_1 != 0 and f2_2 != 0 and f3_1 != 0 and f3_2 != 0 and f4_1 != 0 and f4_2 != 0 and abs(red_V1_s5) > 1e-12:
                red_F1 = ((-1)**(j1 + I1 + f1_2 + 1)) * math.sqrt((2*f1_1+1)*(2*f1_2+1)) * wigner6j(j1, f1_1, I1, f1_2, j2, 1) * red_V1_s5
                if abs(red_F1) > 1e-12:
                    red_F2 = ((-1)**(f1_1 + I2 + f2_2 + 1)) * math.sqrt((2*f2_1+1)*(2*f2_2+1)) * wigner6j(f1_1, f2_1, I2, f2_2, f1_2, 1) * red_F1
                    if abs(red_F2) > 1e-12:
                        red_F3 = ((-1)**(f2_1 + I3 + f3_2 + 1)) * math.sqrt((2*f3_1+1)*(2*f3_2+1)) * wigner6j(f2_1, f3_1, I3, f3_2, f2_2, 1) * red_F2
                        if abs(red_F3) > 1e-12:
                            red_F4 = ((-1)**(f3_1 + I4 + f4_2 + 1)) * math.sqrt((2*f4_1+1)*(2*f4_2+1)) * wigner6j(f3_1, f4_1, I4, f4_2, f3_2, 1) * red_F3
                            if abs(red_F4) > 1e-12:
                                H_tot[i, j] += ((-1)**(f4_2 + I5 + f_1)) * wigner6j(f4_1, I5, f_1, I5, f4_2, 1) * red_F4 * I_mag(I5)
                        
    return H_tot

# =================================================================== #
# 7. Energy Level Solvers                                             #
# =================================================================== #
def solve_energy_levels_sr(Jmax, sigma=0):
    calculate_internal_rotor_constants()
    rot_levels = {}
    num_nuc_spins = len([s for s in P.SPINS if s > 1e-5])
    
    for J in range(Jmax + 3):
        if P.FORMAT == 'SRR' and num_nuc_spins == 0:
            H, K_vals = build_rot_hamiltonian(J)
            w, v = np.linalg.eigh(H)
            idx_sort = np.argsort(w)
            w = w[idx_sort]; v = v[:, idx_sort]
            
            states = []
            ka_counts = {}
            for i in range(len(w)):
                vec = v[:, i]
                dom_idx = np.argmax(np.abs(vec))
                Ka = abs(K_vals[dom_idx])
                ka_counts[Ka] = ka_counts.get(Ka, 0) + 1
                states.append({'E': w[i], 'Ka': Ka})
                
            for Ka in ka_counts.keys():
                ka_states = [s for s in states if s['Ka'] == Ka]
                if Ka == 0: ka_states[0]['Kc'] = J
                else:
                    if len(ka_states) > 0: ka_states[0]['Kc'] = J - Ka + 1
                    if len(ka_states) > 1: ka_states[1]['Kc'] = J - Ka
            
            rot_levels[J] = []
            for s in states:
                s['J'] = J
                s['hfs'] = [{'E': s['E'], 'F': J, 'I': 0.0}] 
                rot_levels[J].append(s)
            continue

        basis = generate_uncoupled_basis(J, -1.0)
        if not basis: continue
        
        H_tot = build_uncoupled_hamiltonian(basis)
        if len(H_tot) == 0: continue
        
        w, v = np.linalg.eigh(H_tot)
        idx_sort = np.argsort(w)
        w = w[idx_sort]; v = v[:, idx_sort]
        
        cost_matrix = np.abs(v)**2
        dim = len(w)
        dom_indices = [-1] * dim
        
        flat_indices = np.argsort(cost_matrix, axis=None)[::-1]
        assigned_vecs = set(); assigned_basis = set()
        
        for flat_idx in flat_indices:
            b_idx = int(flat_idx) // dim
            v_idx = int(flat_idx) % dim
            if v_idx not in assigned_vecs and b_idx not in assigned_basis:
                dom_indices[v_idx] = b_idx
                assigned_vecs.add(v_idx); assigned_basis.add(b_idx)
                if len(assigned_vecs) == dim: break
                
        for v_idx in range(dim):
            if dom_indices[v_idx] == -1:
                col = cost_matrix[:, v_idx]
                sorted_rows = np.argsort(col)[::-1]
                for r in sorted_rows:
                    if r not in assigned_basis:
                        dom_indices[v_idx] = r
                        assigned_basis.add(r)
                        break
        
        states = []
        for i in range(len(w)):
            energy = w[i]
            dom_idx = dom_indices[i]
            
            # --- SAFE DICTIONARY UNPACKING FOR UP TO 5 SPINS ---
            b = basis[dom_idx]
            n_val = J  
            j_val = b.get('j', float(J))
            k_val = b.get('K', 0.0)
            f1_val = b.get('F1', n_val)
            f2_val = b.get('F2', n_val)
            f3_val = b.get('F3', n_val)
            f4_val = b.get('F4', n_val)
            f_final = b.get('F5', b.get('F4', b.get('F3', b.get('F2', b.get('F1', j_val)))))
            
            states.append({
                'E': energy, 'N': n_val, 'Ka': abs(k_val), 'vec': v[:, i],
                'hfs': [{'E': energy, 'J_rad': j_val, 'F1': f1_val, 'F2': f2_val, 'F3': f3_val, 'F4': f4_val, 'F': f_final}]
            })
            
        rot_levels[J] = []
        groups = {}
        for s in states:
            h = s['hfs'][0]
            key = (s['N'], s['Ka'], h['J_rad'], h.get('F1',0), h.get('F2',0), h.get('F3',0), h.get('F4',0), h['F'])
            if key not in groups: groups[key] = []
            groups[key].append(s)
            
        for key, members in groups.items():
            N, Ka = key[0], key[1]
            members.sort(key=lambda x: x['E']) 
            if Ka == 0:
                members[0]['Kc'] = N
                rot_levels[J].append(members[0])
            else:
                if len(members) > 0: members[0]['Kc'] = N - Ka + 1
                if len(members) > 1: members[1]['Kc'] = N - Ka
                if len(members) > 2:
                    for idx in range(2, len(members)): members[idx]['Kc'] = N - Ka
                for m in members: rot_levels[J].append(m)

    return rot_levels

def solve_energy_levels_ir_srr(Jmax, sigma=0):
    calculate_internal_rotor_constants()
    
    if abs(P.Xaa_p) > 1e-12 or abs(P.Xaa_m) > 1e-12:
        P.Xaa  = (P.Xaa_p - P.Xaa_m) / 2.0; P.Xaa2 = (P.Xaa_p + P.Xaa_m) / 2.0
    if abs(P.Xbb_Xcc_p) > 1e-12 or abs(P.Xbb_Xcc_m) > 1e-12:
        P.Xbb_Xcc  = (P.Xbb_Xcc_p - P.Xbb_Xcc_m) / 2.0; P.Xbb_Xcc2 = (P.Xbb_Xcc_p + P.Xbb_Xcc_m) / 2.0
    if abs(P.Xab_p) > 1e-12 or abs(P.Xab_m) > 1e-12:
        P.Xab  = (P.Xab_p - P.Xab_m) / 2.0; P.Xab2 = (P.Xab_p + P.Xab_m) / 2.0
    if abs(P.Xac_p) > 1e-12 or abs(P.Xac_m) > 1e-12:
        P.Xac  = (P.Xac_p - P.Xac_m) / 2.0; P.Xac2 = (P.Xac_p + P.Xac_m) / 2.0
    if abs(P.Xbc_p) > 1e-12 or abs(P.Xbc_m) > 1e-12:
        P.Xbc  = (P.Xbc_p - P.Xbc_m) / 2.0; P.Xbc2 = (P.Xbc_p + P.Xbc_m) / 2.0
    if abs(P.Caa_p) > 1e-12 or abs(P.Caa_m) > 1e-12:
        P.Caa  = (P.Caa_p - P.Caa_m) / 2.0; P.Caa2 = (P.Caa_p + P.Caa_m) / 2.0
    if abs(P.Cbb_p) > 1e-12 or abs(P.Cbb_m) > 1e-12:
        P.Cbb  = (P.Cbb_p - P.Cbb_m) / 2.0; P.Cbb2 = (P.Cbb_p + P.Cbb_m) / 2.0
    if abs(P.Ccc_p) > 1e-12 or abs(P.Ccc_m) > 1e-12:
        P.Ccc  = (P.Ccc_p - P.Ccc_m) / 2.0; P.Ccc2 = (P.Ccc_p + P.Ccc_m) / 2.0

    has_spin = len(P.SPINS) > 0
    I1 = P.SPINS[0] if len(P.SPINS) > 0 else 0.0
    I2 = P.SPINS[1] if len(P.SPINS) > 1 else 0.0
    I_max = I1 + I2; I_min = abs(I1 - I2)
    vt_max = getattr(P, 'VT_MAX', 1)
    
    rot_levels = {}
    for J in range(Jmax + 3):
        H_iam, dim_rot, _ = build_iam_hamiltonian(J, sigma)
        w, v = np.linalg.eigh(H_iam) 
        _, _, _, K_vals = build_matrices(J)
        
        vt_groups = {vt: [] for vt in range(vt_max)}
        for i in range(len(w)):
            dom_idx = np.argmax(np.abs(v[:, i]))
            dom_vt = dom_idx % vt_max
            vt_groups[dom_vt].append((w[i], v[:, i]))
            
        pairs = []
        for ka in range(J + 1):
             for kc in range(J + 1):
                 if (ka + kc == J) or (ka + kc == J + 1): pairs.append((ka, kc))
        pairs.sort(key=lambda x: (x[0], -x[1]))
        
        rot_levels[J] = []
        for vt in range(vt_max):
            vt_groups[vt].sort(key=lambda x: x[0]) 
            for idx, (energy, vec) in enumerate(vt_groups[vt]):
                ka_label, kc_label = pairs[idx] if idx < len(pairs) else (0, 0)
                rot_levels[J].append({
                    'J':J, 'E': energy, 'vec': vec, 
                    'Ka': ka_label, 'Kc': kc_label, 'vt': vt, 
                    'hfs': [], 'K_vals': K_vals
                })

    f_vals = set()
    for J in range(Jmax + 1):
        if has_spin:
            for I_val in np.arange(I_min, I_max + 1.0):
                for f in np.arange(abs(J - I_val), J + I_val + 1.0): f_vals.add(f)
        else: f_vals.add(float(J))
            
    for F in sorted(list(f_vals)):
        basis_blocks = []
        if has_spin:
            valid_J = [j for j in range(Jmax + 3) if abs(F - I_max) <= j <= F + I_max]
            for j in valid_J:
                for I_val in np.arange(I_min, I_max + 1.0):
                    if abs(F - j) <= I_val <= F + j: basis_blocks.append((j, I_val))
        else: basis_blocks = [(int(F), 0.0)]
            
        if not basis_blocks: continue
            
        dim = sum((2*j + 1)*vt_max for j, I_val in basis_blocks)
        H_tot = np.zeros((dim, dim), dtype=complex)
        
        idx_offset = 0; basis_map = []; block_offsets = {}
        
        for j, I_val in basis_blocks:
            H_iam, dim_rot, _ = build_iam_hamiltonian(j, sigma)
            size = dim_rot * vt_max
            H_tot[idx_offset:idx_offset+size, idx_offset:idx_offset+size] = H_iam
            block_offsets[(j, I_val)] = idx_offset
            
            _, _, _, K_vals = build_matrices(j)
            for k in K_vals: 
                for vt in range(vt_max): basis_map.append((j, I_val, k, vt))
            idx_offset += size
            
        if has_spin and I_max > 1e-9:
            for idx1, (j1, I_a) in enumerate(basis_blocks):
                for idx2, (j2, I_b) in enumerate(basis_blocks):
                    if idx1 > idx2: continue 
                    off1, s1_rot = block_offsets[(j1, I_a)], 2*j1 + 1
                    off2, s2_rot = block_offsets[(j2, I_b)], 2*j2 + 1
                    
                    Total_block_rot = np.zeros((s1_rot, s2_rot), dtype=complex)
                    Total_block_rot += build_quadrupole_block(j1, j2, I_a, I_b, F)
                    Total_block_rot += build_spin_rotation_block(j1, j2, I_a, I_b, F)
                    Total_block_rot += build_spin_spin_block(j1, j2, I_a, I_b, F)
                    
                    Total_block_expanded = np.kron(Total_block_rot, np.eye(vt_max))
                    s1_tot = s1_rot * vt_max; s2_tot = s2_rot * vt_max
                    
                    H_tot[off1:off1+s1_tot, off2:off2+s2_tot] += Total_block_expanded
                    if idx1 != idx2: H_tot[off2:off2+s2_tot, off1:off1+s1_tot] += Total_block_expanded.conj().T
        
        w, v = np.linalg.eigh(H_tot)
        for i in range(len(w)):
            eig_val = w[i]; eig_vec = v[:, i]
            dom_idx = np.argmax(np.abs(eig_vec))
            dom_J, dom_I, dom_K, dom_vt = basis_map[dom_idx]
            
            if dom_J > Jmax: continue 
            j_start = block_offsets[(dom_J, dom_I)]
            vec_J = eig_vec[j_start:j_start + (2*dom_J + 1)*vt_max]
            
            best_ov = -1.0; match_idx = 0
            if dom_J > 0 and len(rot_levels[dom_J]) > 0:
                for ri, rstate in enumerate(rot_levels[dom_J]):
                    ov = abs(np.vdot(rstate['vec'], vec_J))
                    if ov > best_ov: best_ov=ov; match_idx=ri
            
            rot_levels[dom_J][match_idx]['hfs'].append({
                'F': F, 'I': dom_I, 'E': eig_val, 'vec': vec_J, 'K_vals': np.arange(-dom_J, dom_J+1)
            })
            
    return {J: [s for s in rot_levels[J] if s['vt'] == 0] for J in range(Jmax + 1)}

def solve_energy_levels(Jmax, sigma=0):
    if P.FORMAT in ['SR', '3SPIN']: return solve_energy_levels_sr(Jmax, sigma)
    else: return solve_energy_levels_ir_srr(Jmax, sigma)


# =================================================================== #
# 8. Fitter Core                                                      #
# =================================================================== #
def run_fit(vary_list):
    print(f"--- Matrix Fit (Numerical Differentiation) ---")
    if P.OLVL > 0: print(f"Loaded Settings: FTH={P.FTH}, FDIF={P.FDIF}, DUMP={P.DUMP}")

    p_vec = np.array([getattr(P, p) for p in vary_list])

    def get_residuals(curr_params):
        for p, val in zip(vary_list, curr_params): setattr(P, p, val)
        needed_J = max([max(ln.N1, ln.N2) for ln in Run.LINES] + [0])
        num_nuc_spins = len([s for s in P.SPINS if s > 1e-5])
        
        if P.FORMAT in ['IR', 'V3', 'INTERNAL']:
            levels_A = solve_energy_levels(needed_J, sigma=0)
            levels_E = solve_energy_levels(needed_J, sigma=1)
        else:
            P.VT_MAX = 1
            levels_A = solve_energy_levels(needed_J, sigma=0)
            levels_E = levels_A

        resids = []
        for ln in Run.LINES:
            levels = levels_E if ln.Sym == 1 else levels_A
            J1_states = levels.get(ln.N1, []); J2_states = levels.get(ln.N2, [])
            e_up = None; e_low = None
            
            if P.FORMAT in ['SR', '3SPIN']:
                for st in J1_states:
                    if abs(st.get('Ka', -1) - ln.K1) < 0.1 and abs(st.get('Kc', -1) - ln.Kp1) < 0.1:
                        for hfs in st.get('hfs', []):
                            if num_nuc_spins >= 3 and abs(hfs.get('J_rad', ln.J1)-ln.J1)<0.1 and abs(hfs.get('F1_1', hfs.get('F1', ln.F1_1))-ln.F1_1)<0.1 and abs(hfs.get('F', ln.F1)-ln.F1)<0.1:
                                e_up = hfs['E']; break
                            elif num_nuc_spins == 2 and abs(hfs.get('J_rad', ln.J1)-ln.J1)<0.1 and abs(hfs.get('F1', ln.F1_1)-ln.F1_1)<0.1 and abs(hfs.get('F', ln.F1)-ln.F1)<0.1:
                                e_up = hfs['E']; break
                            elif num_nuc_spins <= 1 and abs(hfs.get('J_rad', ln.J1)-ln.J1)<0.1 and abs(hfs.get('F', ln.F1)-ln.F1)<0.1:
                                e_up = hfs['E']; break
                        if e_up is not None: break
                for st in J2_states:
                    if abs(st.get('Ka', -1) - ln.K2) < 0.1 and abs(st.get('Kc', -1) - ln.Kp2) < 0.1:
                        for hfs in st.get('hfs', []):
                            if num_nuc_spins >= 3 and abs(hfs.get('J_rad', ln.J2)-ln.J2)<0.1 and abs(hfs.get('F1_1', hfs.get('F1', ln.F2_1))-ln.F2_1)<0.1 and abs(hfs.get('F', ln.F2)-ln.F2)<0.1:
                                e_low = hfs['E']; break
                            elif num_nuc_spins == 2 and abs(hfs.get('J_rad', ln.J2)-ln.J2)<0.1 and abs(hfs.get('F1', ln.F2_1)-ln.F2_1)<0.1 and abs(hfs.get('F', ln.F2)-ln.F2)<0.1:
                                e_low = hfs['E']; break
                            elif num_nuc_spins <= 1 and abs(hfs.get('J_rad', ln.J2)-ln.J2)<0.1 and abs(hfs.get('F', ln.F2)-ln.F2)<0.1:
                                e_low = hfs['E']; break
                        if e_low is not None: break
            else: 
                for st in J1_states:
                    if abs(st.get('K', st.get('Ka', -1)) - ln.K1) < 0.1 and abs(st.get('Kp', st.get('Kc', -1)) - ln.Kp1) < 0.1:
                        if num_nuc_spins == 0: e_up = st['E']; break
                        for hfs in st.get('hfs', [st]): 
                            if num_nuc_spins >= 2 and abs(hfs.get('I', getattr(ln, 'I1', -1)) - getattr(ln, 'I1', -1)) < 0.1 and abs(hfs.get('F', getattr(ln, 'F1', -1)) - getattr(ln, 'F1', -1)) < 0.1:
                                e_up = hfs['E']; break
                            elif num_nuc_spins == 1 and abs(hfs.get('F', getattr(ln, 'F1', -1)) - getattr(ln, 'F1', -1)) < 0.1:
                                e_up = hfs['E']; break
                        if e_up is not None: break
                for st in J2_states:
                    if abs(st.get('K', st.get('Ka', -1)) - ln.K2) < 0.1 and abs(st.get('Kp', st.get('Kc', -1)) - ln.Kp2) < 0.1:
                        if num_nuc_spins == 0: e_low = st['E']; break
                        for hfs in st.get('hfs', [st]):
                            if num_nuc_spins >= 2 and abs(hfs.get('I', getattr(ln, 'I2', -1)) - getattr(ln, 'I2', -1)) < 0.1 and abs(hfs.get('F', getattr(ln, 'F2', -1)) - getattr(ln, 'F2', -1)) < 0.1:
                                e_low = hfs['E']; break
                            elif num_nuc_spins == 1 and abs(hfs.get('F', getattr(ln, 'F2', -1)) - getattr(ln, 'F2', -1)) < 0.1:
                                e_low = hfs['E']; break
                        if e_low is not None: break

            calc = e_up - e_low if (e_up is not None and e_low is not None) else 0.0
            ln.calc = calc
            ln.res = ln.freq - calc
            resids.append(ln.res)

        return np.array(resids)

    prev_rms = None
    for it in range(max(1, Run.NCY)):
        r0 = get_residuals(p_vec)
        
        # Calculate unweighted RMS for printing to terminal
        raw_rms_current = np.sqrt(np.mean(r0**2))
        print(f" Iteration {it+1:2d} ... RMS: {raw_rms_current:.6f} MHz")
        
        current_rss = np.sum([ln.weight * ln.res**2 for ln in Run.LINES])
        current_rms = np.sqrt(current_rss / max(1, len(Run.LINES)))
        
        if prev_rms is not None:
            frac_change = abs(prev_rms - current_rms) / (prev_rms + 1e-20)
            if frac_change < P.FTH:
                print(" Converged! RMS change is less than FTH.")
                break
        prev_rms = current_rms
        
        jac = []
        step = P.FDIF 
        for i, p_name in enumerate(vary_list):
            p_save = p_vec[i]
            p_vec[i] += step
            r_plus = get_residuals(p_vec)
            p_vec[i] = p_save
            deriv = (r0 - r_plus) / step
            jac.append(deriv)
            
        Jac = np.array(jac).T
        W = np.diag([ln.weight for ln in Run.LINES])
        JtW = Jac.T @ W
        
        Alpha = JtW @ Jac + np.eye(len(p_vec)) * P.DUMP
        Beta = JtW @ r0
        
        try: delta_p = np.linalg.solve(Alpha, Beta)
        except: delta_p = np.linalg.pinv(Alpha) @ Beta
        
        if P.OLVL > 1: print(f"  Parameter Shifts: {delta_p}")
            
        p_vec += delta_p
        
        if np.max(np.abs(delta_p)) < 1e-7: 
            print(" Converged! Parameter shifts are negligible.")
            break

    r_fin = get_residuals(p_vec)
    RSS = np.sum([ln.weight * ln.res**2 for ln in Run.LINES])
    dof = max(1, len(Run.LINES) - len(p_vec))
    rms_fit = np.sqrt(RSS/len(Run.LINES))
    raw_rms = np.sqrt(np.mean(r_fin**2))
    
    print(f" Final RMS: {raw_rms:.6f} MHz")
    
    Cov = np.linalg.pinv(Jac.T @ W @ Jac) * (RSS/dof)
    diag_cov = np.diag(Cov).copy()
    diag_cov[diag_cov < 0] = 0.0
    unc = np.sqrt(diag_cov)
    
    return p_vec, unc, RSS, rms_fit, raw_rms

# =================================================================== #
# 9. Writers & Printers                                               #
# =================================================================== #
def fq(v):
    if v is None: return "   0"
    return f"{int(v)}" if v == int(v) else f"{v}"

def get_qn_str(st, hfs, fmt):
    num_nuc_spins = len([s for s in P.SPINS if s > 1e-5])
    N = st.get('N', st.get('J', 0))
    Ka = int(st.get('Ka', st.get('K', st.get('K1', 0))))
    Kc = int(st.get('Kc', st.get('Kp', st.get('Kp1', 0))))
    
    if fmt == 'SR':
        s = f"{fq(N):>2} {fq(Ka):>2} {fq(Kc):>2} {fq(hfs.get('J_rad',N)):>4}"
        if num_nuc_spins == 5:
            s += f" {fq(hfs.get('F1',N)):>4} {fq(hfs.get('F2',N)):>4} {fq(hfs.get('F3',N)):>4} {fq(hfs.get('F4',N)):>4} {fq(hfs.get('F',N)):>4}"
        elif num_nuc_spins == 4:
            s += f" {fq(hfs.get('F1',N)):>4} {fq(hfs.get('F2',N)):>4} {fq(hfs.get('F3',N)):>4} {fq(hfs.get('F',N)):>4}"
        elif num_nuc_spins == 3: 
            s += f" {fq(hfs.get('F1',N)):>4} {fq(hfs.get('F2',N)):>4} {fq(hfs.get('F',N)):>4}"
        elif num_nuc_spins == 2: 
            s += f" {fq(hfs.get('F1',N)):>4} {fq(hfs.get('F',N)):>4}"
        elif num_nuc_spins == 1: 
            s += f" {fq(hfs.get('F',N)):>4}"
        return s
        
    elif fmt == '3SPIN':
        s = f"{fq(N):>2} {fq(Ka):>2} {fq(Kc):>2}"
        if num_nuc_spins == 5:
            s += f" {fq(hfs.get('F1',N)):>4} {fq(hfs.get('F2',N)):>4} {fq(hfs.get('F3',N)):>4} {fq(hfs.get('F4',N)):>4} {fq(hfs.get('F',N)):>4}"
        elif num_nuc_spins == 4:
            s += f" {fq(hfs.get('F1',N)):>4} {fq(hfs.get('F2',N)):>4} {fq(hfs.get('F3',N)):>4} {fq(hfs.get('F',N)):>4}"
        elif num_nuc_spins == 3: 
            s += f" {fq(hfs.get('F1',N)):>4} {fq(hfs.get('F2',N)):>4} {fq(hfs.get('F',N)):>4}"
        elif num_nuc_spins == 2: 
            s += f" {fq(hfs.get('F1',N)):>4} {fq(hfs.get('F',N)):>4}"
        elif num_nuc_spins == 1: 
            s += f" {fq(hfs.get('F',N)):>4}"
        return s
        
    else: # SRR and IR
        s = f"{fq(N):>2} {fq(Ka):>2} {fq(Kc):>2}"
        if num_nuc_spins >= 2: s += f" {fq(hfs.get('I',0)):>4} {fq(hfs.get('F',N)):>4}"
        elif num_nuc_spins == 1: s += f" {fq(hfs.get('F',N)):>4}"
        return s

def format_val_unc(val, unc):
    if unc <= 1e-15: return f"{val:.6f}" if isinstance(val, float) else f"{val}"
    unc_mag = math.floor(math.log10(unc))
    decimals = max(0, -unc_mag + 1)
    unc_int = int(round(unc * (10 ** decimals)))
    return f"{val:.{decimals}f}({unc_int})"

def get_sorted_params(vary_list, x_values, uncertainties=None):
    display_map = {
        'A':'A', 'B':'B', 'C':'C', 'DJ':'DeltaJ', 'DJK':'DeltaJK', 'DK':'DeltaK',
        'dJ':'deltaJ', 'dK':'deltaK', 'd1':'d1', 'd2':'d2',
        'Xaa':'Xaa', 'Xbb_Xcc':'Xbb-Xcc', 'Xab':'Xab', 'Xac':'Xac', 'Xbc':'Xbc',
        'Xaa2':'Xaa2', 'Xbb_Xcc2':'Xbb-Xcc2', 'Xaa3':'Xaa3', 'Xbb_Xcc3':'Xbb-Xcc3','Xaa4':'Xaa4', 'Xbb_Xcc4':'Xbb-Xcc4', 'Xaa5':'Xaa5', 'Xbb_Xcc5':'Xbb-Xcc5',
        'Xaa_p':'Xaa_P', 'Xaa_m':'Xaa_M', 'Xbb_Xcc_p':'Xbb-Xcc_P', 'Xbb_Xcc_m':'Xbb-Xcc_M',
        'AF':'aF', 'TAA':'Taa', 'TBB_TCC':'Tbb-Tcc',
        'AF2':'aF2', 'TAA2':'Taa2', 'TBB_TCC2':'Tbb-Tcc2',
        'AF3':'aF3', 'TAA3':'Taa3', 'TBB_TCC3':'Tbb-Tcc3',
        'Eaa':'Eaa', 'Ebb':'Ebb', 'Ecc':'Ecc', 'Eab':'Eab', 'Ebc':'Ebc', 'Eac':'Eac',
        'Caa':'Caa', 'Cbb':'Cbb', 'Ccc':'Ccc'
    }
    data = {}
    sorted_output = []
    if uncertainties is None: uncertainties = [0.0]*len(vary_list)
    for k, v, u in zip(vary_list, x_values, uncertainties): data[k] = (v, u)
    
    order = ['A','B','C','DJ','DJK','DK','dJ','dK','d1','d2',
             'Xaa','Xbb_Xcc','Xab','Xac','Xbc',
             'Xaa2','Xbb_Xcc2','Xab2','Xac2','Xbc2',
             'Xaa3','Xbb_Xcc3','Xab3','Xac3','Xbc3',
             'Xaa4','Xbb_Xcc4','Xab4','Xac4','Xbc4',
             'Xaa5','Xbb_Xcc5','Xab5','Xac5','Xbc5',
             'Xaa_p','Xaa_m','Xbb_Xcc_p','Xbb_Xcc_m',
             'Eaa', 'Ebb', 'Ecc', 'Eab', 'Ebc', 'Eac',
             'Caa', 'Cbb', 'Ccc', 'Caa2', 'Cbb2', 'Ccc2', 
             'AF', 'TAA', 'TBB_TCC', 'AF2', 'TAA2', 'TBB_TCC2', 'AF3', 'TAA3', 'TBB_TCC3',
             'F0', 'V3']
             
    for k in order:
        if k in data:
            sorted_output.append((display_map.get(k, k), data[k][0], data[k][1]))
            del data[k] 
            
    for k in data:
        sorted_output.append((display_map.get(k, k), data[k][0], data[k][1]))
        
    return sorted_output

def write_publ_file(filename, vary_list, p_vals, unc, rms_raw):
    for k, v in zip(vary_list, p_vals): setattr(P, k, v)
    def get_u(name): return unc[vary_list.index(name)] if name in vary_list else 0.0

    out = []
    if P.PUBL == 2:
        out.append(f"{Run.NAME}")
        out.append("Inputed data: Rotational Constants")
        out.append(f"A = {Run.INIT_A}"); out.append(f"B = {Run.INIT_B}"); out.append(f"C = {Run.INIT_C}")
        out.append("DIPOLE MOMENTS")
        out.append(f"MUA  = {P.MUA}"); out.append(f"MUB  = {P.MUB}"); out.append(f"MUC  = {P.MUC}")
        out.append("--- Fitted Parameters & Derived Inertia ---")
        out.append(f"Total fitted lines: {len(Run.LINES)}")
        out.append(f"RMS: {rms_raw:.6f} MHz")
        out.append("-" * 44)
        
        out.append("1. Rotational Constants (MHz)")
        out.append(f"  A = {format_val_unc(P.A, get_u('A'))}")
        out.append(f"  B = {format_val_unc(P.B, get_u('B'))}")
        out.append(f"  C = {format_val_unc(P.C, get_u('C'))}")
        
        kappa = (2*P.B - P.A - P.C) / (P.A - P.C) if abs(P.A - P.C) > 1e-9 else 0.0
        out.append(f"  Ray's Asymmetry Parameter (Kappa): {kappa:.4f}")
        out.append("-" * 44)
        
        out.append("2. Distortion / Quadrupole / Radical / Internal Rotation")
        display_map = {
            'DJ':'DeltaJ','DJK':'DeltaJK','DK':'DeltaK','dJ':'deltaJ','dK':'deltaK','d1':'d1','d2':'d2',
            'Xaa':'Xaa', 'Xbb_Xcc':'Xbb-Xcc', 'Xaa2':'Xaa2', 'Xbb_Xcc2':'Xbb-Xcc2', 'Xaa3':'Xaa3', 'Xbb_Xcc3':'Xbb-Xcc3',
            'Xaa_p':'Xaa_P', 'Xbb_Xcc_p':'Xbb-Xcc_P', 'Xab_p':'Xab_P', 'Xac_p':'Xac_P', 'Xbc_p':'Xbc_P',
            'Eaa':'Eaa', 'Ebb':'Ebb', 'Ecc':'Ecc', 'Eab':'Eab', 'Ebc':'Ebc', 'Eac':'Eac',
            'AF':'aF', 'TAA':'Taa', 'TBB_TCC':'Tbb-Tcc',
            'AF2':'aF2', 'TAA2':'Taa2', 'TBB_TCC2':'Tbb-Tcc2',
            'AF3':'aF3', 'TAA3':'Taa3', 'TBB_TCC3':'Tbb-Tcc3',
            'Caa':'Caa', 'Cbb':'Cbb', 'Ccc':'Ccc',
            'F0':'F0 (GHz)', 'V3':'V3 (cm-1)'
        }
        
        param_check_list = [
            'DJ','DJK','DK','dJ','dK','d1','d2',
            'Xaa','Xbb_Xcc','Xab','Xac','Xbc',
            'Xaa_p','Xaa_m','Xbb_Xcc_p','Xbb_Xcc_m', 'Xaa2', 'Xbb_Xcc2', 'Xab2', 'Xac2', 'Xbc2', 'Xaa3', 'Xbb_Xcc3', 'Xab3', 'Xac3', 'Xbc3',
            'Eaa', 'Ebb', 'Ecc', 'Eab', 'Ebc', 'Eac',
            'Caa', 'Cbb', 'Ccc', 'Caa2', 'Cbb2', 'Ccc2', 
            'AF', 'TAA', 'TBB_TCC', 'AF2', 'TAA2', 'TBB_TCC2', 'AF3', 'TAA3', 'TBB_TCC3',
            'F0','V3'
        ]
        
        for p_name in param_check_list:
            if hasattr(P, p_name):
                val = getattr(P, p_name)
                if p_name in vary_list or val != 0.0:
                    out.append(f"  {display_map.get(p_name, p_name):<10} = {format_val_unc(val, get_u(p_name))}")
                
        out.append("-" * 44)
        out.append("3. Derived Moments of Inertia (uA^2)")
        out.append("  Conversion factor: 505379.010 MHz uA^2")
        CONV = 505379.010
        
        Ia = CONV / P.A if P.A else 0.0
        Ib = CONV / P.B if P.B else 0.0
        Ic = CONV / P.C if P.C else 0.0
        
        u_Ia = (CONV / (P.A**2)) * get_u('A') if P.A else 0.0
        u_Ib = (CONV / (P.B**2)) * get_u('B') if P.B else 0.0
        u_Ic = (CONV / (P.C**2)) * get_u('C') if P.C else 0.0
        
        out.append(f"  Ia = {format_val_unc(Ia, u_Ia)}")
        out.append(f"  Ib = {format_val_unc(Ib, u_Ib)}")
        out.append(f"  Ic = {format_val_unc(Ic, u_Ic)}\n")
        
        defect = Ic - Ia - Ib
        u_defect = math.sqrt(u_Ic**2 + u_Ia**2 + u_Ib**2)
        out.append(f"  Inertial Defect (Ic - Ia - Ib) = {format_val_unc(defect, u_defect)} uA^2\n")

    with open(filename, 'w') as f: f.write("\n".join(out))

def write_pred_file(filename, vary_list, p_vals, unc, rss, rms_w, rms_raw):
    now = datetime.datetime.now()
    kappa = (2*P.B - P.A - P.C) / (P.A - P.C) if abs(P.A - P.C) > 1e-9 else 0.0
    num_nuc_spins = len([s for s in P.SPINS if s > 1e-5])
    
    with open(filename, 'w') as f:
        f.write(f"{now.strftime('%H:%M:%S')}         MONTH={now.month}  DAY={now.day}  {now.year}\n")
        f.write("Input data: \nRotational Constants\n")
        f.write(f"A = {Run.INIT_A}\nB = {Run.INIT_B}\nC = {Run.INIT_C}\n")
        f.write(f"DIPOLE MOMENTS\nMUA  = {P.MUA}\nMUB  = {P.MUB}\nMUC  = {P.MUC}\n")
        f.write(f"--- {P.FORMAT} HYPERFINE FIT ---\n")
        f.write(f"Input: {filename.replace('.pred','.txt')}\nMolecule : {Run.NAME}\n")
        f.write(f"Hamiltonian: Watson {P.REDUCTION}-reduction ({P.REP} representation)\n")
        f.write(f"Loaded {len(Run.LINES)} transitions.\nFrequency Range: {P.FMIN} - {P.FMAX} MHz\n")
        f.write(f"Ray's Asymmetry Parameter (Kappa): {kappa:.4f}\n\n")
        f.write(f"Fitting {len(vary_list)} params: {vary_list}\n\n")
        f.write("--- Fit Results ---\n")
        f.write(f"RMS (Weighted):   {rms_w:.6f} (Target: ~1.0)\nRMS (Unweighted): {rms_raw:.6f} MHz\n\n")
        f.write(f"          {'Parameters':<23}{'Value':<18}Uncertainty\n" + "-" * 50 + "\n")
        for name, val, u in get_sorted_params(vary_list, p_vals, unc): 
            f.write(f" {name:>14}             {val:13.8f}               {u:10.8f}\n")
        f.write("\n--- Residuals (MHz) ---\n")
        
        if P.FORMAT == 'SR':
            if num_nuc_spins >= 5: hdr = "          N Ka Kc    J   F1   F2   F3   F4    F    N Ka Kc    J   F1   F2   F3   F4    F        Obs        Calc       Diff      Error"
            elif num_nuc_spins >= 4: hdr = "          N Ka Kc    J   F1   F2   F3    F     N Ka Kc    J   F1   F2   F3    F         Obs        Calc       Diff      Error"
            elif num_nuc_spins >= 3: hdr = "          N Ka Kc    J   F1   F2    F      N Ka Kc    J   F1   F2    F         Obs        Calc       Diff      Error"
            elif num_nuc_spins == 2: hdr = "          N Ka Kc    J   F1    F         N Ka Kc    J   F1    F             Obs        Calc       Diff      Error"
            elif num_nuc_spins == 1: hdr = "          N Ka Kc    J    F             N Ka Kc    J    F                Obs        Calc       Diff      Error"
            else: hdr = "          N Ka Kc    J               N Ka Kc    J                  Obs        Calc       Diff      Error"
        elif P.FORMAT == '3SPIN':
            if num_nuc_spins >= 3: hdr = "          J Ka Kc   F1   F2    F         J Ka Kc   F1   F2    F             Obs        Calc       Diff      Error"
            elif num_nuc_spins == 2: hdr = "          J Ka Kc   F1    F             J Ka Kc   F1    F                Obs        Calc       Diff      Error"
            elif num_nuc_spins == 1: hdr = "          J Ka Kc    F                J Ka Kc    F                  Obs        Calc       Diff      Error"
            else: hdr = "          J Ka Kc                         J Ka Kc                     Obs        Calc       Diff      Error"
        else: # SRR
            if num_nuc_spins >= 2: hdr = "          J Ka Kc    I    F             J Ka Kc    I    F                Obs        Calc       Diff      Error"
            elif num_nuc_spins == 1: hdr = "          J Ka Kc    F                J Ka Kc    F                  Obs        Calc       Diff      Error"
            else: hdr = "          J Ka Kc                         J Ka Kc                     Obs        Calc       Diff      Error"
            
        f.write(f"{hdr}\n")
        f.write("-" * len(hdr) + "\n")
        
        for ln in Run.LINES:
            if P.FORMAT == 'SR':
                su = f"{ln.N1:2d} {ln.K1:2d} {ln.Kp1:2d} {fq(ln.J1):>4}"
                sl = f"{ln.N2:2d} {ln.K2:2d} {ln.Kp2:2d} {fq(ln.J2):>4}"
                if num_nuc_spins >= 3:
                    su += f" {fq(ln.F1_1):>4} {fq(ln.F1_2):>4} {fq(ln.F1):>4}"
                    sl += f" {fq(ln.F2_1):>4} {fq(ln.F2_2):>4} {fq(ln.F2):>4}"
                elif num_nuc_spins == 2:
                    su += f" {fq(ln.F1_1):>4} {fq(ln.F1):>4}"
                    sl += f" {fq(ln.F2_1):>4} {fq(ln.F2):>4}"
                elif num_nuc_spins == 1:
                    su += f" {fq(ln.F1):>4}"
                    sl += f" {fq(ln.F2):>4}"
            elif P.FORMAT == '3SPIN':
                su = f"{ln.N1:2d} {ln.K1:2d} {ln.Kp1:2d}"
                sl = f"{ln.N2:2d} {ln.K2:2d} {ln.Kp2:2d}"
                if num_nuc_spins >= 3:
                    su += f" {fq(ln.F1_1):>4} {fq(ln.F1_2):>4} {fq(ln.F1):>4}"
                    sl += f" {fq(ln.F2_1):>4} {fq(ln.F2_2):>4} {fq(ln.F2):>4}"
                elif num_nuc_spins == 2:
                    su += f" {fq(ln.F1_1):>4} {fq(ln.F1):>4}"
                    sl += f" {fq(ln.F2_1):>4} {fq(ln.F2):>4}"
                elif num_nuc_spins == 1:
                    su += f" {fq(ln.F1):>4}"
                    sl += f" {fq(ln.F2):>4}"
            else: # SRR
                su = f"{ln.N1:2d} {ln.K1:2d} {ln.Kp1:2d}"
                sl = f"{ln.N2:2d} {ln.K2:2d} {ln.Kp2:2d}"
                if num_nuc_spins >= 2:
                    su += f" {fq(ln.I1):>4} {fq(ln.F1):>4}"
                    sl += f" {fq(ln.I2):>4} {fq(ln.F2):>4}"
                elif num_nuc_spins == 1:
                    su += f" {fq(ln.F1):>4}"
                    sl += f" {fq(ln.F2):>4}"
                    
            f.write(f"   {su}   {sl}     {ln.freq:10.4f}   {ln.calc:10.4f}   {ln.res:8.5f}   {ln.error:6.4f}\n")
            
        f.write("-" * len(hdr) + "\nPredictions (Center Frequencies)\n\n")
        
        old_format = P.FORMAT
        old_spins = P.SPINS.copy()
        P.FORMAT = 'SRR'
        P.SPINS = []
        is_ir = old_format in ['IR', 'V3', 'INTERNAL']
        if is_ir: level_sets = [("A", solve_energy_levels(P.JMAX, sigma=0)), ("E", solve_energy_levels(P.JMAX, sigma=1))]
        else: P.VT_MAX = 1; level_sets = [("Rigid Rotor", solve_energy_levels(P.JMAX, sigma=0))]
        P.FORMAT = old_format
        P.SPINS = old_spins

        for sym_label, levels in level_sets:
            if is_ir: f.write(f"\n--- {sym_label} State Predictions ---\n")
            for J in range(max(1, P.JMIN), P.JMAX + 1):
                groups = {'A': [], 'B': [], 'C': []}
                for J_lo in [J, J-1]:
                    if J_lo < 0 or J not in levels or J_lo not in levels: continue
                    ups = levels[J]; lows = levels[J_lo]
                    for u in ups:
                        for l in lows:
                            u_Ka = int(u.get('Ka', u.get('K', u.get('K1', 0))))
                            u_Kc = int(u.get('Kc', u.get('Kp', u.get('Kp1', 0))))
                            l_Ka = int(l.get('Ka', l.get('K', l.get('K2', 0))))
                            l_Kc = int(l.get('Kc', l.get('Kp', l.get('Kp2', 0))))
                            
                            dKa = abs(u_Ka - l_Ka)
                            dKc = abs(u_Kc - l_Kc)
                            
                            ttype = None
                            if (dKa % 2 == 0) and (dKc % 2 != 0): ttype = 'A'
                            elif (dKa % 2 != 0) and (dKc % 2 != 0): ttype = 'B'
                            elif (dKa % 2 != 0) and (dKc % 2 == 0): ttype = 'C'
                            
                            if ttype:
                                freq = u['E'] - l['E']
                                if freq < 1e-6 or freq < P.FMIN or freq > P.FMAX: continue
                                u_J = int(u.get('N', u.get('J', 0)))
                                l_J = int(l.get('N', l.get('J', 0)))
                                groups[ttype].append((freq, f" {u_J:2d}    {u_Ka:1d}   {u_Kc:2d}     {l_J:2d}    {l_Ka:1d}   {l_Kc:2d}       {freq:10.3f}\n"))
                                
                for ttype in ['A', 'B', 'C']:
                    lines = groups[ttype]; lines.sort(key=lambda x: x[0])
                    if lines:
                        f.write(f"     {ttype} type transitions for J = {J:2d}\n")
                        for _, txt in lines: f.write(txt)
                        f.write("\n")

def calc_matrix_intensity(u_hfs, l_hfs, Ju, Jl, fmt):
    """
    Calculates the relative line strength of a hyperfine transition
    using the correct angular momentum uncoupling for the specific format.
    """
    S_hfs = 1.0
    u_prev = float(Ju)
    l_prev = float(Jl)
    
    # ========================================================= #
    # 1. SRR Format (Coupled Spin Scheme: I1 + I2 = I -> F)
    # ========================================================= #
    if fmt == 'SRR':
        if 'F' not in u_hfs or 'F' not in l_hfs: return 1.0
        
        u_F = float(u_hfs['F'])
        l_F = float(l_hfs['F'])
        # In SRR, the total nuclear spin is stored as 'I'
        u_I = float(u_hfs.get('I', 0.0))
        l_I = float(l_hfs.get('I', 0.0))
        
        # Primary transitions preserve total I (Delta I = 0)
        if abs(u_I - l_I) > 1e-5: return 0.0 
        
        w6j = wigner6j(u_F, l_F, 1.0, l_prev, u_prev, u_I)
        S_hfs = (2.0 * u_F + 1.0) * (2.0 * l_F + 1.0) * (w6j ** 2)
        return float(S_hfs)

    # ========================================================= #
    # 2. SR and 3SPIN Formats (Sequential Coupling Scheme)
    # ========================================================= #
    num_spins = len([s for s in P.SPINS if s > 1e-5])
    
    # Uncouple Electron Spin (S) for SR format
    if fmt == 'SR':
        elec_S = float(getattr(P, 'S', 0.5))
        u_j = float(u_hfs.get('J_rad', u_hfs.get('j', u_prev)))
        l_j = float(l_hfs.get('J_rad', l_hfs.get('j', l_prev)))
        
        w6j_S = wigner6j(u_j, l_j, 1.0, l_prev, u_prev, elec_S)
        S_hfs *= (2.0 * u_j + 1.0) * (2.0 * l_j + 1.0) * (w6j_S ** 2)
        u_prev, l_prev = u_j, l_j

    # Sequential uncoupling for up to 5 Nuclear Spins
    if num_spins > 0:
        for i in range(1, num_spins + 1):
            u_F, l_F = None, None
            
            # Find the correct F quantum numbers dynamically
            for key in [f'F{i}', 'F5', 'F']:
                if key in u_hfs and u_F is None: u_F = float(u_hfs[key])
                if key in l_hfs and l_F is None: l_F = float(l_hfs[key])
                
            if u_F is None or l_F is None: 
                continue 
                
            I_spin = float(P.SPINS[i-1])
            
            # Uncouple the current spin
            w6j = wigner6j(u_F, l_F, 1.0, l_prev, u_prev, I_spin)
            S_hfs *= (2.0 * u_F + 1.0) * (2.0 * l_F + 1.0) * (w6j ** 2)
            
            # Step down the ladder for the next spin
            u_prev, l_prev = u_F, l_F
            
    return float(S_hfs)

def write_freq_file(filename):
    print("Generating Catalog...")
    trans = []; kT = P.kb_MHz * P.TEMP if hasattr(P, 'kb_MHz') else 2.0836612e4 * P.TEMP
    j_start = max(1, P.JMIN)
    num_nuc_spins = len([s for s in P.SPINS if s > 1e-5])

    is_ir = P.FORMAT in ['IR', 'V3', 'INTERNAL']
    if is_ir: level_sets = [("A_State", solve_energy_levels(P.JMAX, sigma=0)), ("E_State", solve_energy_levels(P.JMAX, sigma=1))]
    else: P.VT_MAX = 1; level_sets = [("", solve_energy_levels(P.JMAX, sigma=0))]

    for state_label, levels in level_sets:
        label_tag = f"  [{state_label}]" if state_label else ""
        for Ju in range(j_start, P.JMAX+1):
            if Ju not in levels: continue
            for Jl in [Ju, Ju-1]:
                if Jl < 0 or Jl not in levels: continue
                ups = levels[Ju]; lows = levels[Jl]
                for u in ups:
                    for l in lows:
                        u_Ka = int(u.get('Ka', u.get('K', u.get('K1', 0))))
                        u_Kc = int(u.get('Kc', u.get('Kp', u.get('Kp1', 0))))
                        l_Ka = int(l.get('Ka', l.get('K', l.get('K2', 0))))
                        l_Kc = int(l.get('Kc', l.get('Kp', l.get('Kp2', 0))))
                        
                        dKa = abs(u_Ka - l_Ka)
                        dKc = abs(u_Kc - l_Kc)
                        
                        mu2 = 0.0
                        if (dKa % 2 == 0) and (dKc % 2 != 0): mu2 = P.MUA**2
                        elif (dKa % 2 != 0) and (dKc % 2 != 0): mu2 = P.MUB**2
                        elif (dKa % 2 != 0) and (dKc % 2 == 0): mu2 = P.MUC**2
                        
                        if mu2 < 1e-10:
                            if P.MUA == 0.0 and P.MUB == 0.0 and P.MUC == 0.0: mu2 = 1.0 
                            else: continue

                        has_format_spins = (P.FORMAT == 'SR') or (num_nuc_spins > 0)
                        
                        if has_format_spins:
                            u_J = u.get('N', u.get('J', 0))
                            l_J = l.get('N', l.get('J', 0))
                            safe_u_hfs = u.get('hfs', [{'E': u['E'], 'F': u_J, 'I': 0.0}])
                            safe_l_hfs = l.get('hfs', [{'E': l['E'], 'F': l_J, 'I': 0.0}])
                            
                            for u_hfs in safe_u_hfs:
                                for l_hfs in safe_l_hfs:
                                    freq = u_hfs['E'] - l_hfs['E']
                                    if freq < P.FMIN or freq > P.FMAX: continue
                                    
                                    # Fallback intensity in case calc_matrix_intensity isn't defined
                                    try: S = calc_matrix_intensity(u_hfs, l_hfs, Ju, Jl, P.FORMAT)
                                    except NameError: S = 1.0
                                    
                                    if S < 1e-9: continue
                                    boltz = math.exp(-l_hfs['E']/kT) - math.exp(-u_hfs['E']/kT)
                                    inten = freq * S * mu2 * boltz
                                    
                                    qu = get_qn_str(u, u_hfs, P.FORMAT)
                                    ql = get_qn_str(l, l_hfs, P.FORMAT)
                                    trans.append({'f': freq, 'i_abs': inten, 'qs': f" {qu}   {ql} {label_tag}"})
                        else:
                            freq = u['E'] - l['E']
                            if freq < P.FMIN or freq > P.FMAX: continue
                            boltz = math.exp(-l['E']/kT) - math.exp(-u['E']/kT)
                            inten = freq * mu2 * boltz
                            
                            qu = get_qn_str(u, {}, P.FORMAT)
                            ql = get_qn_str(l, {}, P.FORMAT)
                            trans.append({'f': freq, 'i_abs': inten, 'qs': f" {qu}   {ql} {label_tag}"})

    if trans:
        max_i = max(t['i_abs'] for t in trans)
        for t in trans: t['i'] = math.log10((t['i_abs']/max_i) + 1e-35)
        
        # --- LINT FILTERING ADDED HERE ---
        # Gets your LINT from the parser, defaults to -99 if not in input file
        lint_threshold = getattr(P, 'LINT', getattr(P, 'LInt', -99.0))
        trans = [t for t in trans if t['i'] >= lint_threshold]
        
    trans.sort(key=lambda x: x['f'])
    
    with open(filename, 'w') as f:
        now = datetime.datetime.now()
        f.write(f"{now.strftime('%H:%M:%S')}         MONTH={now.month}  DAY={now.day}  {now.year}\n")
        
        if P.FORMAT == 'SR':
            if num_nuc_spins >= 5: f.write(f"Frequency      LogInt     N Ka Kc    J   F1   F2   F3   F4    F                N Ka Kc    J   F1   F2   F3   F4    F          (Up - Low)\n")
            elif num_nuc_spins >= 4: f.write(f"Frequency      LogInt     N Ka Kc    J   F1   F2   F3    F                     N Ka Kc    J   F1   F2   F3    F               (Up - Low)\n")
            elif num_nuc_spins >= 3: f.write(f"Frequency      LogInt     N Ka Kc    J   F1   F2    F      N Ka Kc    J   F1   F2    F    (Up - Low)\n")
            elif num_nuc_spins == 2: f.write(f"Frequency      LogInt     N Ka Kc    J   F1    F            N Ka Kc    J   F1    F       (Up - Low)\n")
            elif num_nuc_spins == 1: f.write(f"Frequency      LogInt     N Ka Kc    J    F                 N Ka Kc    J    F          (Up - Low)\n")
            else: f.write(f"Frequency      LogInt     N Ka Kc    J                      N Ka Kc    J                 (Up - Low)\n")
        elif P.FORMAT == '3SPIN':
            if num_nuc_spins >= 3: f.write(f"Frequency      LogInt     J Ka Kc   F1   F2    F         J Ka Kc   F1   F2    F       (Up - Low)\n")
            elif num_nuc_spins == 2: f.write(f"Frequency      LogInt     J Ka Kc   F1    F                J Ka Kc   F1    F          (Up - Low)\n")
            elif num_nuc_spins == 1: f.write(f"Frequency      LogInt     J Ka Kc    F                     J Ka Kc    F               (Up - Low)\n")
            else: f.write(f"Frequency      LogInt     J Ka Kc                              J Ka Kc                        (Up - Low)\n")
        else: # SRR
            if num_nuc_spins >= 2: f.write(f"Frequency      LogInt     J Ka Kc    I    F                J Ka Kc    I    F          (Up - Low)\n")
            elif num_nuc_spins == 1: f.write(f"Frequency      LogInt     J Ka Kc    F                     J Ka Kc    F               (Up - Low)\n")
            else: f.write(f"Frequency      LogInt     J Ka Kc                              J Ka Kc                  (Up - Low)\n")
            
        f.write("-------------------------------------------------------------------------------------------------------\n")
        for t in trans: f.write(f"   {t['f']:10.4f}       {t['i']:7.4f}   {t['qs']}\n")

def main():
    in_file = "3top_input.txt"
    if len(sys.argv) > 1: in_file = sys.argv[1]
    parse_input(in_file)
    vary_list = [p for p, v, f in Run.VARY if f == 2]
    
    if vary_list and Run.LINES:
        p_vec, unc, rss, rms_w, rms_raw = run_fit(vary_list)
        write_pred_file(in_file.replace('.txt','.pred'), vary_list, p_vec, unc, rss, rms_w, rms_raw)
        if P.PUBL == 2: write_publ_file(in_file.replace('.txt','.publ'), vary_list, p_vec, unc, rms_raw)
    else:
        write_pred_file(in_file.replace('.txt','.pred'), [], [], [], 0, 0, 0)
        if P.PUBL == 2: write_publ_file(in_file.replace('.txt','.publ'), [], [], [], 0.0)
            
    write_freq_file(in_file.replace('.txt','.freq'))

if __name__ == "__main__":
    main()
    
#end of file
