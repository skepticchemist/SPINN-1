    TQ2[1] = (2.0*XBB2+XAA2)/math.sqrt(24.0)
    TQ2[2] = XAB2/math.sqrt(6.0)
    TQ2[3] = 0.5*XAA2
    TQ2[4] = -TQ2[2]
    TQ2[5] = TQ2[1]
    
    CC2[1,3] = -(CAA2+CBB2+CCC2)/math.sqrt(3.0)
    CC2[3,1] = 0.5*(CBB2-CCC2)
    CC2[3,3] = (2.0*CAA2-CBB2-CCC2)/math.sqrt(6.0)
    CC2[3,5] = CC2[3,1]
    
    # Spin 3 Dipole and Quadrupole Tensors
    TC3 = np.zeros(6); TQ3 = np.zeros(6); CC3 = np.zeros((4, 6))
    TC3[1] = (2.0*TBB3+TAA3)/math.sqrt(24.0)
    TC3[2] = TAB3/math.sqrt(6.0)
    TC3[3] = 0.5*TAA3
    TC3[4] = -TC3[2]
    TC3[5] = TC3[1]
    
    TQ3[1] = (2.0*XBB3+XAA3)/math.sqrt(24.0)
    TQ3[2] = XAB3/math.sqrt(6.0)
    TQ3[3] = 0.5*XAA3
    TQ3[4] = -TQ3[2]
    TQ3[5] = TQ3[1]
    
    CC3[1,3] = -(CAA3+CBB3+CCC3)/math.sqrt(3.0)
    CC3[3,1] = 0.5*(CBB3-CCC3)
    CC3[3,3] = (2.0*CAA3-CBB3-CCC3)/math.sqrt(6.0)
    CC3[3,5] = CC3[3,1]
    
    COMMON.H.fill(0.0)
    IBSIZE = np.zeros(61, dtype=int)
    JBSIZE = np.zeros(61, dtype=int)
    
    N_arr = np.zeros(5000); KA_arr = np.zeros(5000); FJ_arr = np.zeros(5000)
    F_arr = np.zeros(5000); G_arr = np.zeros(5000)

    for IBLOCK in range(1, COMMON.MXBLK + 1):
        res = SETNJF(R, IBLOCK, ISS)
        if res is None: 
            IBSIZE[IBLOCK+1] = IBSIZE[IBLOCK]
            continue
        NU, JU, FU, GU = res
        FNU, FNU2, F2NU, NNU = float(NU), NU*NU, 2.0*NU+1.0, NU*(NU+1)
        FNNU, F2JU, F2FU, F2GU = float(NNU), 2.0*JU+1.0, 2.0*FU+1.0, 2.0*GU+1.0
        
        if NU != 0: DSQFN = math.sqrt(FNU2 - 1.0)
        else: DSQFN = 0.0
        
        GJ = 0.0 if NU == 0 else (JU*(JU+1.0) - FNNU - 0.75)/(2.0*FNNU)
        
        ADD = ((HSJ*FNNU - DSJ + GJ*SSN + HSJK)*FNNU + BDIF - DSK + GJ*SSK + HSK)*FNNU
        BJJ = ((HLJ*FNNU - DLJ + GJ*SLN)*FNNU + BAVE)*FNNU
        BJJ2 = (HLJK*FNNU - DLJK + GJ*(SLKN+SLNK))*FNNU + AP
        BJJ4 = HLKJ*FNNU - DLK + GJ*SLK
        BSJ = (HSJ*FNNU - DSJ + GJ*SSN + HSJK)*FNNU + BDIF - DSK + GJ*SSK + HSK
        BSJ2 = HSJK*FNNU - DSK + GJ*SSK + 6.0*HSK
        
        for JBLOCK in range(1, IBLOCK + 1):
            resL = SETNJF(R, JBLOCK, ISS)
            if resL is None:
                JBSIZE[JBLOCK+1] = JBSIZE[JBLOCK]
                continue
            NL, JL, FL, GL = resL
            
            NDIA = (NU == NL); JDIA = (JU == JL); FDIA = (FU == FL); GDIA = (GU == GL)
            FNL, FNL2, F2NL, FNNL = float(NL), NL*NL, 2.0*NL+1.0, NL*(NL+1.0)
            F2FL, F2GL = 2.0*FL+1.0, 2.0*GL+1.0
            
            IDN = int(NU - NL)
            if abs(IDN) > 2 or abs(JU-JL) > 2.0 or abs(FU-FL) > 2.0 or abs(GU-GL) > 2.0: continue
            
            TRJ121 = TRJ[int(NU), 1, IDN+2, 0] if abs(IDN) < 3 else 0.0
            
            FSR_val = 0.0; FSRK_0 = 0.0; FSRK_2 = 0.0; FSRK_3 = 0.0
            if abs(NU-NL) <= 1 and JDIA and FDIA and GDIA:
                FSR_val = math.sqrt(SS2S*F2NU*F2NL)*FSGN(int(JU+S)+NL)*SIXJ(FNU,S,JU,S,FNL,1.0)*0.5
                FN2NU = math.sqrt(FNNU*F2NU) if NU > 0 else 0.0
                FN2NL = math.sqrt(FNNL*F2NL) if NL > 0 else 0.0
                FSRK_0 = math.sqrt(1.0)*FSR_val*(FSGN(0)*FN2NU*SIXJ(1.0,1.0,0.0,FNL,FNU,FNU)+FN2NL*SIXJ(1.0,1.0,0.0,FNU,FNL,FNL))
                FSRK_2 = math.sqrt(5.0)*FSR_val*(FSGN(2)*FN2NU*SIXJ(1.0,1.0,2.0,FNL,FNU,FNU)+FN2NL*SIXJ(1.0,1.0,2.0,FNU,FNL,FNL))
                FSRK_3 = FSRK_2 
                
            FHFSG_val = 0.0; FHF_val = 0.0; FHFQ_val = 0.0; FNRK_0 = 0.0; FNRK_2 = 0.0; FNRK_3 = 0.0
            GHFSG_val = 0.0; GHF_val = 0.0; GHFQ_val = 0.0; GNRK_0 = 0.0; GNRK_2 = 0.0; GNRK_3 = 0.0
            RHFSG_val = 0.0; RHF_val = 0.0; RHFQ_val = 0.0; RNRK_0 = 0.0; RNRK_2 = 0.0; RNRK_3 = 0.0
            
            # Spin 1 Blocks
            if abs(JU-JL) <= 1.0 and FDIA and GDIA:
                FACTRS = FSGN(NU+int(JL+S))*SIXJ(FNU,JL,S,1.0,S,JU)
                FACTRH = math.sqrt(30.0*F2NU*F2NL)*X9J(FNL,FNU,2.0,S,S,1.0,JL,JU,1.0)
                FFF = -FSGN(int(JU+FI+FU))*math.sqrt(FII2I*SS2S*F2JU*(2.0*JL+1.0))*SIXJ(FI,JL,FU,JU,FI,1.0)
                if NDIA: FHFSG_val = FFF*FACTRS
                FHF_val = FFF*FACTRH
                
                if FI >= 1.0:
                    FHFQ_val = 0.5 * FSGN(NL+int(S+JU+JU+FI+FU)) * math.sqrt(FIIQ*F2JU*(2.0*JL+1.0)*F2NU*F2NL) * SIXJ(FI,JL,FU,JU,FI,2.0) * SIXJ(FNL,JL,S,JU,FNU,2.0)

            # Spin 2 Blocks
            if abs(JU-JL) <= 1.0 and GDIA and abs(FU-FL) <= 1.0:
                FACTRS = FSGN(NU+int(JL+S))*SIXJ(FNU,JL,S,1.0,S,JU)
                FACTRH = math.sqrt(30.0*F2NU*F2NL)*X9J(FNL,FNU,2.0,S,S,1.0,JL,JU,1.0)
                GGG = FSGN(int(FU+FU+GU+JL+FI+GI)) * math.sqrt(GII2I*SS2S*F2JU*(2.0*JL+1.0)*F2FU*F2FL) * SIXJ(GU,GI,FL,1.0,FU,GI) * SIXJ(FI,JL,FL,1.0,FU,JU)
                if NDIA: GHFSG_val = GGG*FACTRS
                GHF_val = GGG*FACTRH
                
                if GI >= 1.0:
                    GHFQ_val = 0.5 * FSGN(NL+int(S+JU+JL+FI+FU+FU+GI+GU)) * math.sqrt(GIIQ*F2JU*(2.0*JL+1.0)*F2NU*F2NL*F2FU*F2FL) * SIXJ(GI,FL,GU,FU,GI,2.0) * SIXJ(FL,JL,FI,JU,FU,2.0) * SIXJ(FNL,JL,S,JU,FNU,2.0)

            # Spin 3 Blocks
            if abs(GU-GL) <= 1.0 and abs(FU-FL) <= 1.0 and abs(JU-JL) <= 1.0:
                FACTRS = FSGN(NU+int(JL+S))*SIXJ(FNU,JL,S,1.0,S,JU)
                FACTRH = math.sqrt(30.0*F2NU*F2NL)*X9J(FNL,FNU,2.0,S,S,1.0,JL,JU,1.0)
                RRR = -FSGN(int(GU+GU+FU+FL+JL+R+RI+GI+FI)) * math.sqrt(RII2I*SS2S*F2JU*(2.0*JL+1.0)*F2FU*F2FL*F2GU*(2.0*GL+1.0)) * SIXJ(R,RI,GL,1.0,GU,RI) * SIXJ(GI,FL,GL,1.0,GU,FU) * SIXJ(FI,JL,FL,1.0,FU,JU)
                if NDIA: RHFSG_val = RRR*FACTRS
                RHF_val = RRR*FACTRH
                
                if RI >= 1.0:
                    RHFQ_val = 0.5 * FSGN(NL+int(S+JU+JL+FI+FU+FL+GI+GU+GU+RI+R)) * math.sqrt(RIIQ*F2JU*(2.0*JL+1.0)*F2NU*F2NL*F2FU*F2FL*F2GU*(2.0*GL+1.0)) * SIXJ(RI,GL,R,GU,RI,2.0) * SIXJ(GL,FL,GI,FU,GU,2.0) * SIXJ(FL,JL,FI,JU,FU,2.0) * SIXJ(FNL,JL,S,JU,FNU,2.0)
                
            KU0 = ISS if int(NU) % 2 == 0 else 1-ISS
            KL0 = ISS if int(NL) % 2 == 0 else 1-ISS
            
            IEU = IBSIZE[IBLOCK]
            for KU in range(KU0, int(NU)+1):
                FLKK = float(KU*KU)
                IEU += 1
                if JBLOCK == IBLOCK:
                    N_arr[IEU] = NU; KA_arr[IEU] = KU; FJ_arr[IEU] = JU
                    F_arr[IEU] = FU; G_arr[IEU] = GU
                    
                IEL = JBSIZE[JBLOCK]
                for KL in range(KL0, int(NL)+1):
                    IEL += 1
                    if abs(KL-KU) > 2: continue
                    IQ = KL - KU
                    IABIQ = abs(IQ) + 1
                    
                    HD_rot = 0.0; HO_rot = 0.0
                    if NDIA and JDIA and FDIA and GDIA and (SW0 or SWN or SWJ):
                        if KU == KL:
                            HD_rot = ((HLK*FLKK + BJJ4)*FLKK + BJJ2)*FLKK + BJJ
                            if KU == 1 and KU0 == 0: HD_rot -= ADD
                            if KU == 1 and KU0 != 0: HD_rot += ADD
                            if SW0 or SWN or SWJ: COMMON.H[IEL, IEU] = HD_rot
                        elif abs(IQ) == 2:
                            KK = max(KU, KL) - 1
                            FLKX = float(KK*KK)
                            SQQ = math.sqrt(max(0.0, (NNU - KK*(KK+1))*(NNU - KK*(KK-1))))
                            HO_rot = ((HSK*FLKX + BSJ2)*FLKX + BSJ) * SQQ
                            if KK == 1: HO_rot *= math.sqrt(2.0)
                            if SW0 or SWN or SWJ: COMMON.H[IEL, IEU] = HO_rot
                            
                    if SWN: continue
                    
                    HD = 0.0; HO = 0.0
                    if JDIA and FDIA and GDIA and (SW0 or SWJ):
                        if IABIQ <= 1: HD += FSRK_0 * THREJ(int(NL), 0, int(NU), int(-KL), int(IQ), int(KU)) * T[1, IQ+3]
                        if IABIQ <= 3: HD += FSRK_2 * THREJ(int(NL), 2, int(NU), int(-KL), int(IQ), int(KU)) * T[3, IQ+3]
                        if IQ == 0 and KL == 1: HO += FSRK_3 * TRJ121 * T[3, 1]
                        
                        if not NDIA:
                            if IQ == 0:
                                FKU = float(KU)
                                HD -= 0.5 * FKU / FNU * math.sqrt(max(0.0, FNU2 - FLKK)) * (SLK*FLKK + SLNK*FNU2)
                                if KU == 1: HO -= SSK * DSQFN * 0.5
                            elif IABIQ == 3:
                                KS = -KU if IQ > 0 else KU
                                NKPL = NU + KS
                                NKMI = NU - KS
                                val_sqrt = float(NKPL*(NKPL-1)*(NKPL-2)*(NKMI+1))
                                if val_sqrt > 0:
                                    HD -= SSK / (FNU * 4.0) * math.sqrt(val_sqrt) * float(KU*NKMI + (KU+IQ)*(NKMI+2))

                    if not SWJ:
                        THREEJ = TRJ[int(NU), int(KU), IDN+2, IQ+2]
                        # Spin 1 Hyperfine + Quadrupole
                        if FDIA and GDIA and (SW0 or SWF):
                            HD += FHF_val * THREEJ * TC1[IQ+3] + FHFQ_val * THREEJ * TQ1[IQ+3]
                            if KU == KL and NDIA: HD += FHFSG_val * FCNT1
                            if IQ == 0 and KL == 1: HO += FHF_val * TRJ121 * TC1[1] + FHFQ_val * TRJ121 * TQ1[1]
                        # Spin 2 Hyperfine + Quadrupole
                        if GDIA and (SW0 or SWG):
                            HD += GHF_val * THREEJ * TC2[IQ+3] + GHFQ_val * THREEJ * TQ2[IQ+3]
                            if KU == KL and NDIA: HD += GHFSG_val * FCNT2
                            if IQ == 0 and KL == 1: HO += GHF_val * TRJ121 * TC2[1] + GHFQ_val * TRJ121 * TQ2[1]
                        # Spin 3 Hyperfine + Quadrupole
                        if SW0 or SWR:
                            HD += RHF_val * THREEJ * TC3[IQ+3] + RHFQ_val * THREEJ * TQ3[IQ+3]
                            if KU == KL and NDIA: HD += RHFSG_val * FCNT3
                            if IQ == 0 and KL == 1: HO += RHF_val * TRJ121 * TC3[1] + RHFQ_val * TRJ121 * TQ3[1]
                    
                    if (IQ > 0 and KU == 0) or (IQ < 0 and KL == 0): HD *= math.sqrt(2.0)
                    if KL0 == 0: HO = -HO
                    
                    COMMON.H[IEL, IEU] += HD + HO
                    
            IBSIZE[IBLOCK+1] = IEU
            JBSIZE[JBLOCK+1] = IEL

    MSIZE = IEU
    for II in range(1, MSIZE):
        for JJ in range(II+1, MSIZE+1):
            COMMON.H[JJ, II] = COMMON.H[II, JJ]
            
    return MSIZE, N_arr, KA_arr, FJ_arr, F_arr, G_arr

def ENERG(N_in, K_in, FJ_in, F_in, G_in, R_in, NPT, ISS, IDM, KDM, IRD, ISPIN):
    for I in range(1, 61): COMMON.P[I] = COMMON.PAR[I]
        
    MSIZE, NT, KT, FJT, FT, GT = TMTRX(R_in, ISS, 0)
    S, ILL = JACOBD(COMMON.H, 500, MSIZE, 1.0E-12)
    
    EN = np.zeros(IDM+1)
    IT = np.zeros(IDM+1, dtype=int)
    
    for I in range(1, NPT+1):
        for J in range(1, MSIZE+1):
            if (abs(N_in[I] - NT[J]) < 1e-4 and abs(K_in[I] - KT[J]) < 1e-4 and 
                abs(FJ_in[I] - FJT[J]) < 1e-4 and abs(F_in[I] - FT[J]) < 1e-4 and 
                abs(G_in[I] - GT[J]) < 1e-4):
                EN[I] = COMMON.H[J, J]
                IT[I] = J
                
    AV = np.zeros((KDM+1, IDM+1))
    
    for I in range(1, COMMON.NFVAR+1):
        IPAR = COMMON.NIND[I]
        for J in range(61): COMMON.P[J] = 0.0
        COMMON.P[IPAR] = 1.0
        
        TMTRX(R_in, ISS, IPAR)
        
        for II in range(1, NPT+1):
            if IT[II] == 0: continue
            BIBUN = 0.0
            for IA in range(1, MSIZE+1):
                for IB in range(1, MSIZE+1):
                    BIBUN += S[IB, IT[II]] * COMMON.H[IB, IA] * S[IA, IT[II]]
            AV[I, II] = BIBUN
            
    return EN, AV

def FITX(U, V, W, NVAR, LINES):
    N1 = NVAR + 1
    NLINES = sum(1 for K in range(1, LINES+1) if W[K] != 0.0)
    
    U_work = np.zeros((LINES+1, N1+1))
    for K in range(1, LINES+1):
        if W[K] != 0.0:
            WX = math.sqrt(W[K])
            for I in range(1, NVAR+1): U_work[K, I] = U[K, I] * WX
            U_work[K, N1] = V[K] * WX
            
    DNF = np.zeros(61)
    for M in range(1, N1+1):
        Z1 = sum(U_work[K, M]**2 for K in range(1, LINES+1) if W[K] != 0.0)
        DNF[M] = 1.0 / math.sqrt(Z1) if Z1 > 0 else 1.0
        for K in range(1, LINES+1): U_work[K, M] *= DNF[M]
        
    Z0 = 1.0 / DNF[N1] if DNF[N1] != 0 else 1.0
    
    A_mat = np.zeros((61, 61))
    for I in range(1, NVAR+1):
        A_mat[I, I] = 1.0
        for K in range(I+1, N1+1):
            Z2 = sum(U_work[L, I]*U_work[L, K] for L in range(1, LINES+1) if W[L] != 0.0)
            A_mat[I, K] = Z2
            A_mat[K, I] = Z2
            
    FNORM = sum(A_mat[I-1, K]**2 for I in range(2, NVAR+1) for K in range(1, NVAR+1))
    FNORM = 2.0 * FNORM + float(NVAR)
    
    R_mat = np.zeros((61, 61))
    DET = 1.0
    for M in range(1, NVAR+1):
        for J in range(M, N1+1):
            Z2 = sum(R_mat[K, M]*R_mat[K, J] for K in range(1, M)) if M != 1 else 0.0
            Z2 = A_mat[M, J] - Z2
            if J == M:
                DET *= Z2
                R_mat[M, M] = math.sqrt(max(Z2, 1e-15))
            else:
                R_mat[M, J] = Z2 / R_mat[M, M]
                
    X = np.zeros(61)
    Z2_sum = 0.0; Z3_sum = 0.0
    for M in range(NVAR, 0, -1):
        X[M] = (R_mat[M, N1] - Z2_sum) / R_mat[M, M]
        Z3_sum += X[M] * A_mat[M, N1]
        if M != 1:
            Z2_sum = sum(R_mat[M-1, J]*X[J] for J in range(M, NVAR+1))
            
    Z3_sum = (1.0 - Z3_sum) * (1.0/(DNF[N1]**2)) / max(float(NLINES - NVAR), 1.0)
    SIGMA = math.sqrt(max(0.0, Z3_sum))
    
    C_mat = np.zeros((61, 61))
    for I in range(NVAR, 0, -1):
        C_mat[I, I] = 1.0 / R_mat[I, I]**2
        for K in range(I-1, 0, -1):
            Z2 = sum(R_mat[K, N_idx]*C_mat[N_idx, I] for N_idx in range(K+1, NVAR+1))
            C_mat[K, I] = -Z2 / R_mat[K, K]
            C_mat[I, K] = C_mat[K, I]
            
    SE = np.zeros(61)
    for I in range(1, NVAR+1):
        SE[I] = DNF[I] * math.sqrt(max(C_mat[I, I], 0.0)) * SIGMA
        
    X_out = np.zeros(61)
    for M in range(1, NVAR+1): X_out[M] = X[M] * DNF[M] * Z0
    return X_out, SE, SIGMA

