        # --- Spin 1 (Indices 26-35) ---
        'AC1': 26, 'AF': 26, 'AF1': 26, 'FCNT': 26, 'FCNT1': 26,
        'AA1': 27, 'TAA': 27, 'TAA1': 27,
        'BB1': 28, 'TBB': 28, 'TBB1': 28,
        'AB1': 29, 'TAB': 29, 'TAB1': 29,
        'CAA1': 30, 'CAA': 30, 
        'CBB1': 31, 'CBB': 31, 
        'CCC1': 32, 'CCC': 32,
        'XAA1': 33, 'XAA': 33,
        'XBB1': 34, 'XBB': 34,
        'XAB1': 35, 'XAB': 35,

        # --- Spin 2 (Indices 36-45) ---
        'AC2': 36, 'AF2': 36, 'FCNT2': 36,
        'AA2': 37, 'TAA2': 37,
        'BB2': 38, 'TBB2': 38,
        'AB2': 39, 'TAB2': 39,
        'CAA2': 40, 'CBB2': 41, 'CCC2': 42,
        'XAA2': 43, 'XBB2': 44, 'XAB2': 45,

        # --- Spin 3 (Indices 46-55) ---
        'AC3': 46, 'AF3': 46, 'FCNT3': 46,
        'AA3': 47, 'TAA3': 47,
        'BB3': 48, 'TBB3': 48,
        'AB3': 49, 'TAB3': 49,
        'CAA3': 50, 'CBB3': 51, 'CCC3': 52,
        'XAA3': 53, 'XBB3': 54, 'XAB3': 55,
    }

    for raw_key, val in params_in.items():
        key_upper = raw_key.strip().upper()
        if key_upper in name_to_index:
            idx = name_to_index[key_upper]
            COMMON.PAR[idx] = val
            if flags_in[raw_key] == 2:
                COMMON.NFVAR += 1
                COMMON.NIND[COMMON.NFVAR] = idx
                COMMON.SPAR[idx] = raw_key.ljust(4)[:4]
                
    if 'SPIN' in config:
        spin_vals = list(map(float, config['SPIN']))
        COMMON.DI1 = spin_vals[0] if len(spin_vals) > 0 else 0.0
        COMMON.DI2 = spin_vals[1] if len(spin_vals) > 1 else 0.0
        COMMON.DI3 = spin_vals[2] if len(spin_vals) > 2 else 0.0
    else:
        COMMON.DI1, COMMON.DI2, COMMON.DI3 = 1.5, 0.0, 0.0
        
    COMMON.MXBLK = int(16.0 * (COMMON.DI1 + 0.5) * (COMMON.DI2 + 0.5) * (COMMON.DI3 + 0.5))
    
    NDATA = len(df)
    IDM = NDATA + 10
    KDM = 60
    
    N_arr = np.zeros(IDM); K_arr = np.zeros(IDM); FJ_arr = np.zeros(IDM)
    F_arr = np.zeros(IDM); G_arr = np.zeros(IDM); R_arr = np.zeros(IDM)
    ISYM = np.zeros(IDM, dtype=int)
    
    N_arr_L = np.zeros(IDM); K_arr_L = np.zeros(IDM); FJ_arr_L = np.zeros(IDM)
    F_arr_L = np.zeros(IDM); G_arr_L = np.zeros(IDM); R_arr_L = np.zeros(IDM)
    ISYM_L = np.zeros(IDM, dtype=int)
    
    ENO = np.zeros(IDM); W = np.zeros(IDM)
    
    for i in range(NDATA):
        row = df.iloc[i]
        idx = i + 1
        N_arr[idx] = row['N_p']; K_arr[idx] = row['Ka_p']; FJ_arr[idx] = row['J_p']
        F_arr[idx] = row['F_p']; G_arr[idx] = row['F_p']; R_arr[idx] = row['F_p']
        ISYM[idx] = int(row['Kc_p']) % 2 
        
        N_arr_L[idx] = row['N_pp']; K_arr_L[idx] = row['Ka_pp']; FJ_arr_L[idx] = row['J_pp']
        F_arr_L[idx] = row['F_pp']; G_arr_L[idx] = row['F_pp']; R_arr_L[idx] = row['F_pp']
        ISYM_L[idx] = int(row['Kc_pp']) % 2 
        
        ENO[idx] = row['Freq']; W[idx] = 1.0 / (row['Err']**2) if row['Err'] != 0 else 0.0

    print(f"\n==============================================")
    print(f"                    SPINN")
    print(f"==============================================")
    print(f"{title}")
    
    U = np.zeros((IDM, KDM))
    V = np.zeros(IDM)
    EC = np.zeros(IDM)
    
    for ICY in range(10): 
        EC.fill(0.0)
        U.fill(0.0)
        
        for ISS in [0, 1]:
            for IA in [1, 2]:
                R_search = R_arr if IA == 1 else R_arr_L
                N_s = N_arr if IA == 1 else N_arr_L
                K_s = K_arr if IA == 1 else K_arr_L
                FJ_s = FJ_arr if IA == 1 else FJ_arr_L
                F_s = F_arr if IA == 1 else F_arr_L
                G_s = G_arr if IA == 1 else G_arr_L
                SYM_s = ISYM if IA == 1 else ISYM_L
                
                unique_R = np.unique([R_search[i] for i in range(1, NDATA+1) if SYM_s[i] == ISS])
                
                for RA in unique_R:
                    ITROW = []; NPT = 0
                    N_pass = [0]; K_pass = [0]; FJ_pass = [0]; F_pass = [0]; G_pass = [0]
                    
                    for I in range(1, NDATA+1):
                        if R_search[I] == RA and SYM_s[I] == ISS:
                            NPT += 1
                            ITROW.append(I)
                            N_pass.append(N_s[I]); K_pass.append(K_s[I]); FJ_pass.append(FJ_s[I])
                            F_pass.append(F_s[I]); G_pass.append(G_s[I])
                            
                    if NPT == 0: continue
                    
                    EN_res, AV_res = ENERG(N_pass, K_pass, FJ_pass, F_pass, G_pass, RA, NPT, ISS, IDM, KDM, 20, 1)
                    
                    XUL = 1.0 if IA == 1 else -1.0
                    for IPT in range(1, NPT+1):
                        IROW = ITROW[IPT-1]
                        EC[IROW] += EN_res[IPT] * XUL
                        for L in range(1, COMMON.NFVAR+1):
                            U[IROW, L] += AV_res[L, IPT] * XUL

        for I in range(1, NDATA+1):
            V[I] = ENO[I] - EC[I]
            
        X_out, SE_out, SIGMA = FITX(U, V, W, COMMON.NFVAR, NDATA)
        
        print(f"Iteration {ICY+1} - RMS = {SIGMA:.5f} Dimensionless")
        for I in range(1, COMMON.NFVAR+1):
            ID = COMMON.NIND[I]
            COMMON.PAR[ID] += X_out[I] * COMMON.DUMP
            
        if max(abs(X_out[1:COMMON.NFVAR+1])) < 1e-8: break

    # Unweighted True RMS Calculation
    raw_residuals = [V[I] for I in range(1, NDATA+1) if W[I] != 0.0]
    true_rms_mhz = math.sqrt(sum(r**2 for r in raw_residuals) / len(raw_residuals))

    print(f"\n[✓] Final Fit Complete!")
    
    # Write the new format files
    write_pred_file("fit_results.pred", title, true_rms_mhz, SIGMA, df, ENO, EC, V, W)
    write_freq_file("fit_results.freq", title, df, EC)
    print(f"--> Saved output to 'fit_results.pred' and 'fit_results.freq'")
    
    
    
