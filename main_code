# Wigner Cache
POX = np.zeros(200)
for i in range(200):
    POX[i] = math.log(math.factorial(i)) if i > 0 else 0.0

def DFUNC(A, C, B):
    return POX[int(A+B-C)] + POX[int(A-B+C)] + POX[int(B+C-A)] - POX[int(A+B+C)+1]

def FSGN(I):
    return 1.0 if int(I) % 2 == 0 else -1.0

def TCHEK(A, B, C):
    if C >= abs(A - B) and C <= A + B: return False
    return True

def SIXJ(A, B, C, D, E, F):
    if TCHEK(A, B, C): return 0.0
    if TCHEK(A, E, F): return 0.0
    if TCHEK(D, B, F): return 0.0
    if TCHEK(D, E, C): return 0.0
    
    IABDE = int(A + B + D + E)
    IBCEF = int(B + C + E + F)
    ICAFD = int(C + A + F + D)
    IABC = int(A + B + C)
    IAEF = int(A + E + F)
    IDBF = int(D + B + F)
    IDEC = int(D + E + C)
    
    MIN_val = max(IABC, IAEF, IDBF, IDEC)
    MAX_val = min(IABDE, IBCEF, ICAFD)
    if MAX_val < MIN_val: return 0.0
    
    FL = 0.5 * (DFUNC(A, B, C) + DFUNC(A, E, F) + DFUNC(D, B, F) + DFUNC(D, E, C))
    ans = 0.0
    for I in range(MIN_val, MAX_val + 1):
        P = math.exp(FL + POX[I+1] - POX[I-IABC] - POX[I-IAEF] - POX[I-IDBF] - POX[I-IDEC] 
                     - POX[IABDE-I] - POX[IBCEF-I] - POX[ICAFD-I])
        if I % 2 != 0: P = -P
        ans += P
    return ans

def THREJ(J1, J2, J3, M1, M2, M3):
    if J3 < abs(J1 - J2) or J3 > J1 + J2: return 0.0
    if M1 + M2 + M3 != 0: return 0.0
    
    L1, L2 = int(J1+M1), int(J1-M1)
    L3 = int(J2+M2)
    N1 = int(J1+J2-J3)
    N2 = int(J2-J3-M1)
    N3 = int(J1+M2-J3)
    N4 = int(J1-J2-M3)
    
    MAX_val = min(N1, L2, L3)
    MIN_val = max(N2, N3, 0)
    if MAX_val < MIN_val: return 0.0
    
    FL = 0.5 * (POX[N1] + POX[int(J1-J2+J3)] + POX[int(J2-J1+J3)] - POX[int(J1+J2+J3)+1] + 
                POX[L1] + POX[L2] + POX[L3] + POX[int(J2-M2)] + POX[int(J3+M3)] + POX[int(J3-M3)])
    
    ans = 0.0
    for I in range(MIN_val, MAX_val + 1):
        P = math.exp(FL - POX[N1-I] - POX[L2-I] - POX[L3-I] - POX[I-N2] - POX[I-N3] - POX[I])
        if (I + N4) % 2 != 0: P = -P
        ans += P
    if L1 % 2 != 0: ans = -ans
    return ans

def X9J(A1, A2, A3, B1, B2, B3, C1, C2, C3):
    MIN_val = int(2.0 * max(abs(A1-C3), abs(A2-B3), abs(B1-C2)))
    MAX_val = int(2.0 * min(A1+C3, A2+B3, B1+C2))
    ans = 0.0
    for I in range(MIN_val, MAX_val + 1, 2):
        FI = I * 0.5
        P = (2.0*FI+1.0) * SIXJ(A1,B1,C1,C2,C3,FI) * SIXJ(A2,B2,C2,B1,FI,B3) * SIXJ(A3,B3,C3,FI,A1,A2)
        if I % 2 != 0: P = -P
        ans += P
    return ans

