def parse_spectroscopy_file(filepath):
    with open(filepath, 'r') as f:
        lines = f.readlines()
    title = lines[0].strip()
    config, params, fit_flags = {}, {}, {}
    transitions = []
    mode = "CONFIG_AND_PARAMS" 
    
    config_keys = {"ITER", "FORMAT", "REDUCTION", "REP", "SPIN", "FTH", "FDIF", "OLVL", "PUBL", "DIAG", "DUMP", "TEMP", "JMIN", "JMAX", "FMIN", "FMAX", "MUA", "MUB", "MUC", "LInt"}
    for line in lines[1:]:
        line = line.strip()
        if not line or line.startswith('#') or line.startswith('-'): continue
        if line.startswith("TRANSITIONS"): mode = "TRANSITIONS"; continue
        if mode == "CONFIG_AND_PARAMS":
            parts = line.split()
            key = parts[0]
            if key in config_keys: config[key] = parts[1:]
            else:
                try:
                    val = float(parts[1])
                    flag = int(parts[2]) if len(parts) > 2 else 0
                    params[key] = val
                    fit_flags[key] = flag
                except (ValueError, IndexError): continue
        elif mode == "TRANSITIONS":
            parts = line.split()
            if len(parts) >= 10:
                try: transitions.append([float(x) for x in parts])
                except ValueError: pass

    if len(transitions) > 0 and len(transitions[0]) >= 12:
        cleaned_trans = []
        for t in transitions:
            if len(t) == 12: cleaned_trans.append([t[0], t[1], t[2], t[3], t[4], t[5], t[6], t[7], t[8], t[9], t[10], t[11]])
            elif len(t) >= 14: cleaned_trans.append([t[0], t[1], t[2], t[3], t[4], t[6], t[7], t[8], t[9], t[10], t[12], t[13]])
        df = pd.DataFrame(cleaned_trans, columns=["N_p", "Ka_p", "Kc_p", "J_p", "F_p", "N_pp", "Ka_pp", "Kc_pp", "J_pp", "F_pp", "Freq", "Err"])
    else:
        df = pd.DataFrame(transitions, columns=["N_p", "Ka_p", "Kc_p", "F_p", "N_pp", "Ka_pp", "Kc_pp", "F_pp", "Freq", "Err"])
        df['J_p'] = -1.0; df['J_pp'] = -1.0
    return title, config, params, fit_flags, df

