def SETNJF(R, NBLK, ISS):
    XN = np.zeros(61); XJ = np.zeros(61); XF = np.zeros(61); XG = np.zeros(61)
    ID = 1
    II3 = int(COMMON.DI3 * 2.0)
    for III3 in range(-II3, II3+1, 2):
        I3 = III3 / 2.0
        II2 = int(COMMON.DI2 * 2.0)
        for III2 in range(-II2, II2+1, 2):
            I2 = III2 / 2.0
            II1 = int(COMMON.DI1 * 2.0)
            for III1 in range(-II1, II1+1, 2):
                I1 = III1 / 2.0
                for IS in [-1, 1]:
                    S = IS / 2.0
                    XG[ID] = I3
                    XF[ID] = XG[ID] + I2
                    XJ[ID] = XF[ID] + I1
                    XN[ID] = XJ[ID] + S
                    ID += 1
    
    N = R + XN[NBLK]
    J = R + XJ[NBLK]
    F = R + XF[NBLK]
    G = R + XG[NBLK]
    
    if N < 0 or J < 0 or F < 0 or G < 0: return None
    if ISS == 1 and N == 0: return None
    return N, J, F, G

def JACOBD(A, NDIM, N, RHO):
    S = np.zeros((NDIM+1, NDIM+1))
    DEL = np.zeros(501); B = np.zeros(501)
    ZERO = 1.0E-30
    
    for I in range(1, N):
        for J in range(I+1, N+1):
            if abs(A[I, J] - A[J, I]) > ZERO: return S, 30000

    if N < 2 or NDIM < N or RHO <= 0.0 or N > 500: return S, 30000

    AN = float(N)
    ANORM = 0.0
    for I in range(1, N):
        for J in range(I+1, N+1):
            ANORM += A[I, J]**2
    ANORM = math.sqrt(2.0 * ANORM)
    FNORM = RHO * ANORM / AN
    
    for I in range(1, N+1): S[I, I] = 1.0

    ISWEEP = 0
    THRESH = ANORM / AN
    
    while True:
        for I in range(1, N+1):
            B[I] = A[I, I]
            DEL[I] = 0.0
            
        IND = 0
        for IQ in range(2, N+1):
            for IP in range(1, IQ):
                if abs(A[IP, IQ]) > THRESH:
                    IND = 1
                    C = 2.0 * A[IP, IQ]
                    D = A[IQ, IQ] - A[IP, IP]
                    G = C*C + D*D
                    G1 = math.sqrt(G)
                    ABSD = abs(D)
                    COV = math.sqrt((1.0 + ABSD/G1) / 2.0)
                    SIV = C / (2.0 * COV * G1)
                    if D < 0.0: SIV = -SIV
                    APP = A[IP, IP]
                    AQQ = A[IQ, IQ]
                    
                    for I in range(1, N+1):
                        U = A[IP, I]; V = A[IQ, I]
                        A[IP, I] = COV*U - SIV*V
                        A[IQ, I] = COV*V + SIV*U
                        U = S[I, IP]; V = S[I, IQ]
                        S[I, IP] = COV*U - SIV*V
                        S[I, IQ] = COV*V + SIV*U
                        
                    A[IP, IQ] = 0.0
                    A[IQ, IP] = 0.0
                    
                    ETA = C*C / (2.0 * (G1 + ABSD))
                    if D < 0.0: ETA = -ETA
                    
                    DEL[IP] -= ETA
                    DEL[IQ] += ETA
                    A[IP, IP] = APP - ETA
                    A[IQ, IQ] = AQQ + ETA
                    
                    for I in range(1, N+1):
                        A[I, IP] = A[IP, I]
                        A[I, IQ] = A[IQ, I]
                        
        if IND == 0:
            if THRESH <= FNORM: break
            THRESH = THRESH / AN
            continue
            
        for I in range(1, N+1):
            A[I, I] = B[I] + DEL[I]
            
        if ISWEEP >= 100: return S, 1
        ISWEEP += 1
        
    return S, 0

