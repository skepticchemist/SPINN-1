def write_pred_file(filename, title, true_rms, sigma, df, ENO, EC, V, W):
    now = datetime.datetime.now()
    with open(filename, 'w') as f:
        f.write(f"{now.strftime('%H:%M:%S')} MONTH={now.month} DAY={now.day} {now.year}\n")
        f.write(f"--- FIT RESULTS FOR: {title} ---\n")
        f.write(f"OVERALL RMS ERROR : {true_rms:10.5f} MHz  (Dimensionless Sigma: {sigma:8.5f})\n")
        f.write("-" * 50 + "\n")
        f.write(f"{'Parameter':<12} {'Fitted Value':>15} {'Std. Error':>15}\n")
        f.write("-" * 45 + "\n")
        for I in range(1, COMMON.NFVAR+1):
            ID = COMMON.NIND[I]
            f.write(f"{COMMON.SPAR[ID].strip():<12} {COMMON.PAR[ID]:15.6f} {SE_out[I]:15.6f}\n")
            
        f.write("\n\n")
        f.write("  J Ka Kc  F   J Ka Kc  F       Observed   Calculated     Obs-Calc     Error\n")
        f.write("-" * 80 + "\n")
        for I in range(1, len(df)+1):
            if W[I] == 0.0: continue
            row = df.iloc[I-1]
            j_up = f"{row['J_p']}" if row['J_p'] >= 0 else ""
            j_lo = f"{row['J_pp']}" if row['J_pp'] >= 0 else ""
            
            su = f"{int(row['N_p']):2d} {int(row['Ka_p']):2d} {int(row['Kc_p']):2d} {row['F_p']:4.1f}"
            sl = f"{int(row['N_pp']):2d} {int(row['Ka_pp']):2d} {int(row['Kc_pp']):2d} {row['F_pp']:4.1f}"
            err_val = math.sqrt(1.0/W[I]) if W[I] > 0 else 0.0
            
            f.write(f" {su:>10}  {sl:>10}  {ENO[I]:13.4f} {EC[I]:12.4f} {V[I]:12.4f} {err_val:9.4f}\n")

def write_freq_file(filename, title, df, EC):
    with open(filename, 'w') as f:
        f.write(f"Frequency LogInt  J Ka Kc F  J Ka Kc F (Up - Low) - {title}\n")
        for I in range(1, len(df)+1):
            row = df.iloc[I-1]
            j_up = f"{row['J_p']}" if row['J_p'] >= 0 else ""
            j_lo = f"{row['J_pp']}" if row['J_pp'] >= 0 else ""
            
            su = f"{int(row['N_p']):2d} {int(row['Ka_p']):2d} {int(row['Kc_p']):2d} {row['F_p']:4.1f}"
            sl = f"{int(row['N_pp']):2d} {int(row['Ka_pp']):2d} {int(row['Kc_pp']):2d} {row['F_pp']:4.1f}"
            dummy_intensity = -5.0000 
            
            f.write(f"{EC[I]:11.4f}  {dummy_intensity:7.4f}   {su:>10}  {sl:>10}   {title}\n")

